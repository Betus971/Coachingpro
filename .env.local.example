# Copie ce fichier en .env.local SUR LE SERVEUR et adapte les valeurs.
# .env.local n'est PAS versionné (gitignore) — c'est volontaire.

# ── Environnement Symfony ──────────────────────────────────────────────────
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_HEX_STRING

# ── Base de données ────────────────────────────────────────────────────────
# Format : pgsql://user:password@host:port/dbname?serverVersion=16
DATABASE_URL="postgresql://coach_user:CHANGE_ME@127.0.0.1:5432/coachingpro?serverVersion=16&charset=utf8"

# ── JWT (Lexik) ────────────────────────────────────────────────────────────
# Les clés sont générées par bin/console lexik:jwt:generate-keypair (idempotent dans deploy.sh).
# JWT_PASSPHRASE doit être défini AVANT la génération des clés.
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=CHANGE_ME_RANDOM_PASSPHRASE
# Durée de vie du token en secondes (1h par défaut, on peut monter à 86400 = 24h)
JWT_TTL=3600

# ── API Externes ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ── CORS (pour app mobile) ─────────────────────────────────────────────────
# Liste des origines autorisées séparées par virgules.
# Mets ici l'URL d'où l'app mobile va appeler l'API (LAN dev, prod, etc.).
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1|192\.168\.\d+\.\d+)(:[0-9]+)?$'

# ── Mailer (optionnel — pour reset password plus tard) ─────────────────────
MAILER_DSN=null://null
