<!DOCTYPE html>
<html lang="fr" data-theme="coachpro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Connexion — CoachPro</title>
  {{ importmap('app') }}
  <script>
    (function() {
      const saved = localStorage.getItem('coachpro-theme');
      if (saved) document.documentElement.setAttribute('data-theme', saved);
    })();
  </script>
</head>
<body class="bg-base-100 text-base-content min-h-screen flex items-center justify-center">
  <div class="w-full max-w-sm px-6 page-content">

    {# Logo #}
    <div class="text-center mb-10">
      <div class="font-display text-5xl text-primary leading-none">COACH</div>
      <div class="font-display text-5xl text-base-content leading-none">PRO</div>
      <div class="text-xs text-muted tracking-widest mt-2 uppercase">Programme 121 → 95 kg</div>
    </div>

    {# Theme toggle #}
    <div class="flex justify-center mb-6">
      <button onclick="toggleTheme()" class="theme-toggle" aria-label="Changer le thème" id="login-theme-toggle">
        <svg class="w-4 h-4 theme-icon-sun" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
        </svg>
        <svg class="w-4 h-4 theme-icon-moon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
        </svg>
      </button>
    </div>

    {# Error #}
    {% if error %}
      <div class="alert alert-error text-sm mb-4">
        {{ error.messageKey|trans(error.messageData, 'security') }}
      </div>
    {% endif %}

    {# Form #}
    <form method="post" action="{{ path('app_login') }}" class="flex flex-col gap-4">
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

      <div class="form-control">
        <label class="label pb-1">
          <span class="label-text text-xs tracking-widest uppercase text-muted">Email</span>
        </label>
        <input type="email" name="_username" value="{{ last_username }}" required autofocus
               class="input input-bordered bg-base-300 border-neutral focus:border-primary focus:outline-none w-full"
               placeholder="leo@coachpro.local">
      </div>

      <div class="form-control">
        <label class="label pb-1">
          <span class="label-text text-xs tracking-widest uppercase text-muted">Mot de passe</span>
        </label>
        <input type="password" name="_password" required
               class="input input-bordered bg-base-300 border-neutral focus:border-primary focus:outline-none w-full"
               placeholder="••••••••">
      </div>

      <label class="flex items-center gap-3 cursor-pointer mt-1">
        <input type="checkbox" name="_remember_me" class="checkbox checkbox-primary checkbox-sm">
        <span class="text-sm text-muted-strong">Se souvenir de moi</span>
      </label>

      <button type="submit"
              class="btn btn-primary w-full mt-2 font-display text-lg tracking-widest">
        CONNEXION
      </button>
    </form>

    <p class="text-center text-sm text-muted mt-6">
      Pas encore de compte ?
      <a href="{{ path('app_register') }}" class="text-primary hover:underline">Créer un compte</a>
    </p>

  </div>

  <script>
    function updateThemeIcons() {
      const isDark = document.documentElement.getAttribute('data-theme') === 'coachpro';
      document.querySelectorAll('.theme-icon-sun').forEach(el => el.classList.toggle('hidden', !isDark));
      document.querySelectorAll('.theme-icon-moon').forEach(el => el.classList.toggle('hidden', isDark));
    }
    function toggleTheme() {
      const html = document.documentElement;
      const next = html.getAttribute('data-theme') === 'coachpro' ? 'coachpro-light' : 'coachpro';
      html.setAttribute('data-theme', next);
      localStorage.setItem('coachpro-theme', next);
      updateThemeIcons();
    }
    updateThemeIcons();
  </script>
</body>
</html>
