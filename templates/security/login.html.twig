<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Connexion — CoachPro</title>
  <script>document.documentElement.setAttribute('data-theme', localStorage.getItem('theme') || 'dark');</script>
  {{ importmap('app') }}
</head>
<body class="bg-base-200 text-base-content min-h-screen flex items-center justify-center">

  <div class="w-full max-w-sm px-6 py-10">

    {# Logo #}
    <div class="text-center mb-10">
      <div class="font-display text-5xl text-primary leading-none">COACH</div>
      <div class="font-display text-5xl text-base-content leading-none">PRO</div>
      <div class="text-xs text-muted tracking-widest mt-2 uppercase">Programme 121 → 95 kg</div>
    </div>

    {# Erreur Symfony #}
    {% if error %}
      <div class="alert alert-error text-sm mb-4 shadow-sm">
        {{ error.messageKey|trans(error.messageData, 'security') }}
      </div>
    {% endif %}

    {# Formulaire #}
    <form method="post" action="{{ path('app_login') }}" class="flex flex-col gap-4">
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

      <div class="form-control">
        <label class="label pb-1">
          <span class="label-text text-xs tracking-widest uppercase text-muted">Email</span>
        </label>
        <input type="email" name="_username" value="{{ last_username }}" required autofocus
               class="input input-bordered bg-base-100 focus:border-primary focus:outline-none w-full"
               placeholder="leo@coachpro.local">
      </div>

      <div class="form-control">
        <label class="label pb-1">
          <span class="label-text text-xs tracking-widest uppercase text-muted">Mot de passe</span>
        </label>
        <input type="password" name="_password" required
               class="input input-bordered bg-base-100 focus:border-primary focus:outline-none w-full"
               placeholder="••••••••">
      </div>

      <label class="flex items-center gap-3 cursor-pointer mt-1">
        <input type="checkbox" name="_remember_me" class="checkbox checkbox-primary checkbox-sm">
        <span class="text-sm text-muted-strong">Se souvenir de moi</span>
      </label>

      <button type="submit"
              class="btn btn-primary w-full mt-2 font-display text-lg tracking-widest">
        CONNEXION
      </button>

      <div class="divider text-xs text-muted uppercase tracking-widest my-2">OU</div>

      <a href="{{ path('connect_google_sso') }}" class="btn btn-outline w-full">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 24 24"><path fill="currentColor" d="M21.35 11.1h-9.17v2.73h6.51c-.33 3.81-3.5 5.44-6.5 5.44C8.36 19.27 5 16.25 5 12c0-4.1 3.2-7.27 7.2-7.27c3.09 0 4.9 1.97 4.9 1.97L19 4.72S16.56 2 12.1 2C6.42 2 2.03 6.8 2.03 12c0 5.05 4.13 10 10.22 10c5.35 0 9.25-3.67 9.25-9.09c0-1.15-.15-1.81-.15-1.81Z"/></svg>
        Continuer avec Google
      </a>
    </form>

    <p class="text-center text-sm text-muted mt-6">
      Pas encore de compte ?
      <a href="{{ path('app_register') }}" class="text-primary hover:underline">Créer un compte</a>
    </p>

    {# Toggle thème discret — aligné sur localStorage('theme') comme base.html.twig #}
    <div class="flex justify-center mt-8">
      <button onclick="toggleLoginTheme()" class="btn btn-ghost btn-sm btn-circle opacity-40 hover:opacity-100" title="Changer de thème">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>
        </svg>
      </button>
    </div>
  </div>

  <script>
    function toggleLoginTheme() {
      const html = document.documentElement;
      const current = html.getAttribute('data-theme') || 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
    }
  </script>

</body>
</html>
