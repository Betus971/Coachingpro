<!DOCTYPE html>
<html lang="fr" data-theme="coachpro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Créer un compte — CoachPro</title>
  {{ importmap('app') }}
  <script>
    (function() {
      const saved = localStorage.getItem('coachpro-theme');
      if (saved) document.documentElement.setAttribute('data-theme', saved);
    })();
  </script>
</head>
<body class="bg-base-100 text-base-content min-h-screen flex items-center justify-center py-12">
  <div class="w-full max-w-md px-6 page-content">

    {# Logo #}
    <div class="text-center mb-8">
      <div class="font-display text-5xl text-primary leading-none">COACH</div>
      <div class="font-display text-5xl text-base-content leading-none">PRO</div>
      <div class="text-xs text-muted tracking-widest mt-2 uppercase">Créer un compte</div>
    </div>

    {# Theme toggle #}
    <div class="flex justify-center mb-6">
      <button onclick="toggleTheme()" class="theme-toggle" aria-label="Changer le thème">
        <svg class="w-4 h-4 theme-icon-sun" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
        </svg>
        <svg class="w-4 h-4 theme-icon-moon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
        </svg>
      </button>
    </div>

    {# Error #}
    {% if error %}
      <div class="alert alert-error text-sm mb-5">
        {{ error }}
      </div>
    {% endif %}

    <form method="post" action="{{ path('app_register') }}" class="flex flex-col gap-4">

      {# Identité #}
      <div class="grid grid-cols-2 gap-3">
        <div class="form-control">
          <label class="label pb-1">
            <span class="label-text text-xs tracking-widest uppercase text-muted">Prénom *</span>
          </label>
          <input type="text" name="first_name" required autofocus
                 class="input input-bordered bg-base-300 border-neutral focus:border-primary w-full"
                 placeholder="Léo">
        </div>
        <div class="form-control">
          <label class="label pb-1">
            <span class="label-text text-xs tracking-widest uppercase text-muted">Nom *</span>
          </label>
          <input type="text" name="last_name" required
                 class="input input-bordered bg-base-300 border-neutral focus:border-primary w-full"
                 placeholder="Dupont">
        </div>
      </div>

      <div class="form-control">
        <label class="label pb-1">
          <span class="label-text text-xs tracking-widest uppercase text-muted">Email *</span>
        </label>
        <input type="email" name="email" required
               class="input input-bordered bg-base-300 border-neutral focus:border-primary w-full"
               placeholder="leo@example.com">
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div class="form-control">
          <label class="label pb-1">
            <span class="label-text text-xs tracking-widest uppercase text-muted">Mot de passe *</span>
          </label>
          <input type="password" name="password" required minlength="8"
                 class="input input-bordered bg-base-300 border-neutral focus:border-primary w-full"
                 placeholder="8 car. min.">
        </div>
        <div class="form-control">
          <label class="label pb-1">
            <span class="label-text text-xs tracking-widest uppercase text-muted">Confirmer *</span>
          </label>
          <input type="password" name="confirm" required
                 class="input input-bordered bg-base-300 border-neutral focus:border-primary w-full"
                 placeholder="••••••••">
        </div>
      </div>

      {# Rôle #}
      <div class="form-control">
        <label class="label pb-1">
          <span class="label-text text-xs tracking-widest uppercase text-muted">Rôle</span>
        </label>
        <select name="role" class="select select-bordered bg-base-300 border-neutral focus:border-primary">
          <option value="ROLE_CLIENT">Client (je suis suivi par un coach)</option>
          <option value="ROLE_COACH">Coach (je gère des clients)</option>
        </select>
      </div>

      {# Divider profil #}
      <div class="divider text-xs text-muted tracking-widest uppercase my-1">Profil physique (optionnel)</div>

      <div class="grid grid-cols-3 gap-3">
        <div class="form-control">
          <label class="label pb-1">
            <span class="label-text text-xs tracking-widest uppercase text-muted">Taille (cm)</span>
          </label>
          <input type="number" name="height_cm" min="100" max="250" placeholder="183"
                 class="input input-bordered bg-base-300 border-neutral focus:border-primary w-full">
        </div>
        <div class="form-control">
          <label class="label pb-1">
            <span class="label-text text-xs tracking-widest uppercase text-muted">Sexe</span>
          </label>
          <select name="sex" class="select select-bordered bg-base-300 border-neutral focus:border-primary">
            <option value="">—</option>
            <option value="male">Homme</option>
            <option value="female">Femme</option>
            <option value="other">Autre</option>
          </select>
        </div>
        <div class="form-control">
          <label class="label pb-1">
            <span class="label-text text-xs tracking-widest uppercase text-muted">Naissance</span>
          </label>
          <input type="date" name="birth_date"
                 class="input input-bordered bg-base-300 border-neutral focus:border-primary w-full">
        </div>
      </div>

      <button type="submit"
              class="btn btn-primary w-full mt-2 font-display text-lg tracking-widest">
        CRÉER MON COMPTE
      </button>
    </form>

    <p class="text-center text-sm text-muted mt-6">
      Déjà un compte ?
      <a href="{{ path('app_login') }}" class="text-primary hover:underline">Se connecter</a>
    </p>

  </div>

  <script>
    function updateThemeIcons() {
      const isDark = document.documentElement.getAttribute('data-theme') === 'coachpro';
      document.querySelectorAll('.theme-icon-sun').forEach(el => el.classList.toggle('hidden', !isDark));
      document.querySelectorAll('.theme-icon-moon').forEach(el => el.classList.toggle('hidden', isDark));
    }
    function toggleTheme() {
      const html = document.documentElement;
      const next = html.getAttribute('data-theme') === 'coachpro' ? 'coachpro-light' : 'coachpro';
      html.setAttribute('data-theme', next);
      localStorage.setItem('coachpro-theme', next);
      updateThemeIcons();
    }
    updateThemeIcons();
  </script>
</body>
</html>
