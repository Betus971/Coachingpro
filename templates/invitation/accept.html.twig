<!DOCTYPE html>
<html lang="fr" data-theme="coachpro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rejoindre CoachPro</title>
  {{ importmap('app') }}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
  <script>
    (function () {
      const saved = localStorage.getItem('coachpro-theme');
      if (saved) document.documentElement.setAttribute('data-theme', saved);
    })();
  </script>
</head>
<body class="bg-base-100 text-base-content min-h-screen flex items-center justify-center py-12">
  <div class="w-full max-w-md px-6">

    <div class="text-center mb-8">
      <div class="font-display text-5xl text-primary leading-none">COACH</div>
      <div class="font-display text-5xl text-base-content leading-none">PRO</div>
      <div class="text-xs text-muted tracking-widest mt-2 uppercase">Rejoindre ton coach</div>
    </div>

    {% if state == 'ok' %}
      <div class="card bg-base-100 border border-base-200 shadow-xl">
        <div class="card-body gap-4">
          <p class="text-sm text-base-content/70">
            <i class="bi bi-person-check text-primary"></i>
            {{ invitation.coach.firstName }} {{ invitation.coach.lastName }} t'invite à rejoindre son suivi.
            Crée ton mot de passe pour activer ton compte.
          </p>

          {% if error %}
            <div class="alert alert-error shadow-sm"><span><i class="bi bi-exclamation-triangle"></i> {{ error }}</span></div>
          {% endif %}

          <form method="post" class="space-y-4">
            <div>
              <label class="label-text font-bold text-muted uppercase text-xs">Email</label>
              <input type="email" value="{{ invitation.email }}" readonly
                     class="input input-bordered w-full bg-base-200 mt-1" />
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="label-text font-bold text-muted uppercase text-xs">Prénom</label>
                <input type="text" name="first_name" value="{{ invitation.firstName }}" required
                       class="input input-bordered w-full bg-base-100 mt-1" />
              </div>
              <div>
                <label class="label-text font-bold text-muted uppercase text-xs">Nom</label>
                <input type="text" name="last_name" value="{{ invitation.lastName }}" required
                       class="input input-bordered w-full bg-base-100 mt-1" />
              </div>
            </div>
            <div>
              <label class="label-text font-bold text-muted uppercase text-xs">Mot de passe (8 caractères min.)</label>
              <input type="password" name="password" required minlength="8"
                     class="input input-bordered w-full bg-base-100 mt-1" />
            </div>
            <div>
              <label class="label-text font-bold text-muted uppercase text-xs">Confirme le mot de passe</label>
              <input type="password" name="confirm" required minlength="8"
                     class="input input-bordered w-full bg-base-100 mt-1" />
            </div>
            <button class="btn btn-primary w-full font-display tracking-widest">
              <i class="bi bi-check2-circle"></i> Créer mon compte
            </button>
          </form>
        </div>
      </div>
    {% else %}
      <div class="card bg-base-100 border border-base-200 shadow-xl">
        <div class="card-body text-center gap-3">
          <i class="bi bi-exclamation-circle text-4xl text-error"></i>
          <p class="text-base-content/70">
            {% if state == 'expired' %}
              Cette invitation a expiré. Demande à ton coach de t'en renvoyer une.
            {% elseif state == 'used' %}
              Cette invitation a déjà été utilisée ou révoquée.
            {% else %}
              Lien d'invitation invalide.
            {% endif %}
          </p>
          <a href="{{ path('app_login') }}" class="btn btn-outline btn-sm"><i class="bi bi-box-arrow-in-right"></i> Aller à la connexion</a>
        </div>
      </div>
    {% endif %}

  </div>
</body>
</html>
