<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}CoachPro{% endblock %}</title>
  <script>document.documentElement.setAttribute('data-theme', localStorage.getItem('theme') || 'dark');</script>
  {{ importmap('app') }}
</head>
<body class="bg-base-200 min-h-screen">

  {# ── NAVBAR ────────────────────────────────────────────────────────────────── #}
  {% set current = app.request.attributes.get('_route') %}
  <div class="navbar bg-base-100 shadow-sm px-4 mb-6 sticky top-0 z-50">

    {# Logo #}
    <div class="navbar-start">
      <a href="{{ path('app_dashboard') }}" class="btn btn-ghost gap-2 px-2 text-lg font-bold tracking-tight">
        CoachPro <span class="text-xs font-normal opacity-40 hidden sm:inline">Suivi sportif</span>
      </a>
    </div>

    {# Nav desktop #}
    <div class="navbar-center hidden lg:flex">
      <ul class="menu menu-horizontal px-1 gap-1">
        <li>
          <a href="{{ path('app_dashboard') }}" class="{{ current == 'app_dashboard' ? 'active' : '' }}">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
            Dashboard
          </a>
        </li>
        <li>
          <a href="{{ path('app_weight_index') }}" class="{{ current starts with 'app_weight' ? 'active' : '' }}">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/></svg>
            Poids
          </a>
        </li>
        <li>
          <a href="{{ path('app_session_index') }}" class="{{ current starts with 'app_session' ? 'active' : '' }}">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            Séances
          </a>
        </li>
        <li>
          <a href="{{ path('app_nutrition_index') }}" class="{{ current starts with 'app_nutrition' ? 'active' : '' }}">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
            Nutrition
          </a>
        </li>
        <li>
          <a href="{{ path('app_program_show') }}" class="{{ current starts with 'app_program' ? 'active' : '' }}">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
            Programme
          </a>
        </li>
      </ul>
    </div>

    {# Droite : thème + user #}
    <div class="navbar-end gap-2">

      {# Dropdown thème #}
      <div class="dropdown dropdown-end">
        <button tabindex="0" class="btn btn-ghost btn-circle" title="Changer de thème">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>
          </svg>
        </button>
        <ul tabindex="0" class="dropdown-content menu p-2 shadow-lg bg-base-100 rounded-box w-44 z-50 border border-base-300">
          <li class="menu-title text-xs px-2 pb-1 opacity-50">Thème</li>
          <li><button onclick="setTheme('dark')"      class="theme-btn flex gap-2 items-center"><span style="width:1rem;height:1rem;border-radius:50%;background:#1d232a;border:1px solid #374151;flex-shrink:0;display:inline-block"></span> Sombre</button></li>
          <li><button onclick="setTheme('light')"     class="theme-btn flex gap-2 items-center"><span style="width:1rem;height:1rem;border-radius:50%;background:#ffffff;border:1px solid #e5e7eb;flex-shrink:0;display:inline-block"></span> Clair</button></li>
          <li><button onclick="setTheme('business')"  class="theme-btn flex gap-2 items-center"><span style="width:1rem;height:1rem;border-radius:50%;background:#1c1917;border:2px solid #eab308;flex-shrink:0;display:inline-block"></span> Business</button></li>
          <li><button onclick="setTheme('nord')"      class="theme-btn flex gap-2 items-center"><span style="width:1rem;height:1rem;border-radius:50%;background:#e5e9f0;border:1px solid #88c0d0;flex-shrink:0;display:inline-block"></span> Nord</button></li>
          <li><button onclick="setTheme('corporate')" class="theme-btn flex gap-2 items-center"><span style="width:1rem;height:1rem;border-radius:50%;background:#f9fafb;border:2px solid #1d4ed8;flex-shrink:0;display:inline-block"></span> Corporate</button></li>
          <li><button onclick="setTheme('valentine')" class="theme-btn flex gap-2 items-center"><span style="width:1rem;height:1rem;border-radius:50%;background:#fbcfe8;border:2px solid #f472b6;flex-shrink:0;display:inline-block"></span> Valentine</button></li>
        </ul>
      </div>

      {# Dropdown user #}
      {% if app.user %}
        <div class="dropdown dropdown-end">
          <div tabindex="0" role="button" class="btn btn-ghost btn-circle avatar placeholder">
            <div class="bg-primary text-primary-content rounded-full w-9">
              <span class="text-sm font-bold">{{ app.user.firstName ? app.user.firstName|first|upper : app.user.email|first|upper }}</span>
            </div>
          </div>
          <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-50 w-52 p-2 shadow-lg mt-2 border border-base-300">
            <li class="menu-title">
              <span class="text-xs truncate">{{ app.user.firstName }} {{ app.user.lastName }}</span>
              <span class="text-xs opacity-40 truncate">{{ app.user.email }}</span>
            </li>
            <li>
              <a href="{{ path('app_profile') }}" class="{{ current starts with 'app_profile' ? 'active' : '' }}">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                Mon Profil
              </a>
            </li>
            <li><hr class="my-1 border-base-200"></li>
            <li>
              <a href="{{ path('app_logout') }}" class="text-error">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                Se déconnecter
              </a>
            </li>
          </ul>
        </div>
      {% endif %}

      {# Burger mobile #}
      <div class="dropdown dropdown-end lg:hidden">
        <div tabindex="0" role="button" class="btn btn-ghost btn-circle">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </div>
        <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-50 w-56 p-2 shadow-lg mt-2 border border-base-300">
          <li><a href="{{ path('app_dashboard') }}" class="{{ current == 'app_dashboard' ? 'active' : '' }}">Dashboard</a></li>
          <li><a href="{{ path('app_weight_index') }}" class="{{ current starts with 'app_weight' ? 'active' : '' }}">Poids</a></li>
          <li><a href="{{ path('app_session_index') }}" class="{{ current starts with 'app_session' ? 'active' : '' }}">Séances</a></li>
          <li><a href="{{ path('app_nutrition_index') }}" class="{{ current starts with 'app_nutrition' ? 'active' : '' }}">Nutrition</a></li>
          <li><a href="{{ path('app_program_show') }}" class="{{ current starts with 'app_program' ? 'active' : '' }}">Programme</a></li>
          <li><hr class="my-1 border-base-200"></li>
          <li><a href="{{ path('app_profile') }}">Mon Profil</a></li>
          <li><a href="{{ path('app_logout') }}" class="text-error">Déconnexion</a></li>
        </ul>
      </div>
    </div>
  </div>

  {# ── CONTENU PRINCIPAL ─────────────────────────────────────────────────────── #}
  <main class="container mx-auto px-4 pb-8 max-w-7xl">

    {# Flash messages #}
    {% for type, messages in app.flashes %}
      {% for message in messages %}
        <div class="alert alert-{{ type == 'success' ? 'success' : (type == 'error' ? 'error' : 'info') }} shadow-sm mb-4">
          <span>{{ message }}</span>
        </div>
      {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
  </main>

  <script>
    function setTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem('theme', theme);
      document.activeElement && document.activeElement.blur();
    }
    (function() {
      var current = localStorage.getItem('theme') || 'dark';
      document.querySelectorAll('.theme-btn').forEach(function(btn) {
        btn.classList.toggle('active', btn.getAttribute('onclick') === "setTheme('" + current + "')");
      });
    })();
  </script>

  {# ── CHAT IA FLOTTANT ─────────────────────────────────────────────────────── #}
  {{ include('_chat_widget.html.twig') }}

{#
  DaisyUI theme safelist — Tailwind scanner anchor, do not remove.
  Tailwind v4 scans templates as plain text: even inside a Twig comment,
  data-theme values are detected and DaisyUI generates the corresponding CSS.
  data-theme="valentine" data-theme="business" data-theme="nord"
  data-theme="corporate" data-theme="cupcake" data-theme="dracula"
  data-theme="cyberpunk" data-theme="synthwave" data-theme="luxury"
  data-theme="night" data-theme="dim" data-theme="sunset" data-theme="forest"
#}
</body>
</html>
