<!DOCTYPE html>
<html lang="fr" data-theme="nord">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}CoachPro{% endblock %}</title>
  {{ importmap('app') }}
  <script>
    // Apply saved theme BEFORE render to avoid flash
    (function() {
      const saved = localStorage.getItem('coachpro-theme');
      if (saved) document.documentElement.setAttribute('data-theme', saved);
    })();
  </script>
</head>
<body class="bg-base-100 text-base-content min-h-screen">

  <div class="drawer lg:drawer-open">
    <input id="main-drawer" type="checkbox" class="drawer-toggle" />
    
    <div class="drawer-content flex flex-col">
      <!-- Navbar Mobile & Desktop Header -->
      <div class="w-full navbar bg-base-200 lg:hidden">
        <div class="flex-none">
          <label for="main-drawer" aria-label="open sidebar" class="btn btn-square btn-ghost">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-6 h-6 stroke-current"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
          </label>
        </div>
        <div class="flex-1 px-2 mx-2 font-display text-xl text-primary">COACH<span class="text-base-content">PRO</span></div>
      </div>
      
      <!-- Main Content -->
      <main class="flex-1 p-4 md:p-6 lg:p-8">
        {# Flash messages #}
        <div class="toast toast-top toast-end z-50">
          {% for type, messages in app.flashes %}
            {% for message in messages %}
              <div class="alert alert-{{ type == 'success' ? 'success' : (type == 'error' ? 'error' : 'info') }} shadow-lg">
                <span>{{ message }}</span>
              </div>
            {% endfor %}
          {% endfor %}
        </div>
        
        {% block body %}{% endblock %}
      </main>
    </div> 
    
    <!-- Sidebar -->
    <div class="drawer-side z-40">
      <label for="main-drawer" aria-label="close sidebar" class="drawer-overlay"></label> 
      <div class="menu p-4 w-72 min-h-full bg-base-200 text-base-content flex flex-col">
        <!-- Logo -->
        <div class="px-4 py-4 mb-4 border-b border-base-300">
          <div class="font-display text-4xl text-primary leading-none">COACH<span class="text-base-content">PRO</span></div>
          <div class="text-xs text-muted tracking-widest mt-1 uppercase">121 &rarr; 95 KG</div>
        </div>

        <!-- Navigation -->
        {% set current = app.request.attributes.get('_route') %}
        <ul class="flex-1 gap-2">
          <li>
            <a href="{{ path('app_dashboard') }}" class="{{ current == 'app_dashboard' ? 'active' : '' }}">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
              Tableau de bord
            </a>
          </li>
          <li>
            <a href="{{ path('app_weight_index') }}" class="{{ current starts with 'app_weight' ? 'active' : '' }}">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/></svg>
              Poids
            </a>
          </li>
          <li>
            <a href="{{ path('app_session_index') }}" class="{{ current starts with 'app_session' ? 'active' : '' }}">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              Séances
            </a>
          </li>
          <li>
            <a href="{{ path('app_nutrition_index') }}" class="{{ current starts with 'app_nutrition' ? 'active' : '' }}">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
              Nutrition
            </a>
          </li>
          <li>
            <a href="{{ path('app_program_show') }}" class="{{ current starts with 'app_program' ? 'active' : '' }}">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
              Programme
            </a>
          </li>
          <li>
            <a href="{{ path('app_profile') }}" class="{{ current starts with 'app_profile' ? 'active' : '' }}">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
              Mon Profil
            </a>
          </li>
        </ul>

        <!-- Footer / User Info -->
        <div class="mt-auto pt-4 border-t border-base-300">
          <div class="flex items-center justify-between mb-2 px-2">
            <div class="min-w-0 flex-1">
              <div class="text-sm font-medium truncate">{{ app.user ? app.user.firstName : 'Invité' }}</div>
              <div class="text-xs text-muted truncate">{{ app.user ? app.user.email : '' }}</div>
            </div>
            <a href="{{ path('app_logout') }}" class="btn btn-ghost btn-sm text-muted hover:text-error">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
            </a>
          </div>
          <!-- Theme Switcher -->
          <select id="theme-selector" class="select select-bordered select-sm w-full mt-2" onchange="changeTheme(this.value)">
            <option disabled selected>Thème</option>
            <optgroup label="Sombres">
              <option value="nord">Nord</option>
              <option value="sunset">Sunset</option>
              <option value="caramellatte">Caramellatte</option>
              <option value="abyss">Abyss</option>
              <option value="coachpro">CoachPro (Custom)</option>
            </optgroup>
            <optgroup label="Clairs">
              <option value="light">Light</option>
              <option value="winter">Winter</option>
              <option value="corporate">Corporate</option>
            </optgroup>
          </select>
        </div>
      </div>
    </div>
  </div>

  <script>
    function changeTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem('coachpro-theme', theme);
    }
    
    // Set the select to the current theme
    window.addEventListener('DOMContentLoaded', () => {
      const currentTheme = document.documentElement.getAttribute('data-theme');
      const selector = document.getElementById('theme-selector');
      if (currentTheme && [...selector.options].some(opt => opt.value === currentTheme)) {
        selector.value = currentTheme;
      }
    });

    // Close drawer on link click in mobile view
    document.querySelectorAll('.drawer-side a').forEach(link => {
      link.addEventListener('click', () => {
        if(window.innerWidth < 1024) {
          document.getElementById('main-drawer').checked = false;
        }
      });
    });
  </script>

</body>
</html>
