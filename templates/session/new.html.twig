{% extends 'base.html.twig' %}
{% set isEdit = session is defined and session %}
{% block title %}{{ isEdit ? 'Modifier la séance' : 'Nouvelle séance' }} — CoachPro{% endblock %}

{% block body %}
<div class="px-6 md:px-8 py-8 max-w-3xl">

  <div class="mb-8">
    <div class="section-tag mb-3">Training</div>
    <h1 class="font-display text-4xl md:text-5xl">{{ isEdit ? 'MODIFIER LA SÉANCE' : 'LOGGER UNE SÉANCE' }}</h1>
  </div>

  <form action="{{ isEdit ? path('app_session_update', {id: session.id}) : path('app_session_create') }}" method="post" id="session-form">

    {# ── Infos séance ────────────────────────────────────────────────────── #}
    <div class="card-coach p-6 mb-6">
      <h2 class="font-display text-xl mb-4 text-muted-strong tracking-widest">INFORMATIONS</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="form-control md:col-span-2">
          <label class="label pb-1">
            <span class="label-text text-xs tracking-widest uppercase text-muted">Nom de la séance</span>
          </label>
          <input type="text" name="name" required placeholder="Push — Lundi"
                 value="{{ isEdit ? session.name : '' }}"
                 class="input input-bordered bg-base-300 border-neutral focus:border-primary">
        </div>
        <div class="form-control">
          <label class="label pb-1">
            <span class="label-text text-xs tracking-widest uppercase text-muted">Date & heure</span>
          </label>
          <input type="datetime-local" name="performed_at"
                 value="{{ isEdit ? session.performedAt|date('Y-m-d\\TH:i') : 'now'|date('Y-m-d\\TH:i') }}"
                 class="input input-bordered bg-base-300 border-neutral focus:border-primary">
        </div>
        <div class="form-control">
          <label class="label pb-1">
            <span class="label-text text-xs tracking-widest uppercase text-muted">Durée (min)</span>
          </label>
          <input type="number" name="duration_minutes" min="0" max="300" placeholder="65"
                 value="{{ isEdit ? session.durationMinutes : '' }}"
                 class="input input-bordered bg-base-300 border-neutral focus:border-primary">
        </div>
        <div class="form-control">
          <label class="label pb-1">
            <span class="label-text text-xs tracking-widest uppercase text-muted">Effort ressenti · RPE (1–10)</span>
          </label>
          <input type="number" name="rpe" min="1" max="10" placeholder="7"
                 value="{{ isEdit ? session.rpe : '' }}"
                 class="input input-bordered bg-base-300 border-neutral focus:border-primary">
        </div>
        <div class="form-control">
          <label class="label pb-1">
            <span class="label-text text-xs tracking-widest uppercase text-muted">Séance type (optionnel)</span>
          </label>
          <select name="source_template_id"
                  class="select select-bordered bg-base-300 border-neutral focus:border-primary">
            <option value="">— Freestyle —</option>
            {% for template in templates %}
              <option value="{{ template.id }}" {{ isEdit and session.sourceTemplate and session.sourceTemplate.id == template.id ? 'selected' : '' }}>{{ template.name }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="form-control md:col-span-2">
          <label class="label pb-1">
            <span class="label-text text-xs tracking-widest uppercase text-muted">Notes</span>
          </label>
          <textarea name="notes" rows="2" placeholder="Bon sommeil, bonne énergie…"
                    class="textarea textarea-bordered bg-base-300 border-neutral focus:border-primary">{{ isEdit ? session.notes : '' }}</textarea>
        </div>
      </div>
    </div>

    {# ── Sets ────────────────────────────────────────────────────────────── #}
    {# ── Ajout rapide : favoris + récents ───────────────────────────────── #}
    {% set favIds = (favorites is defined ? favorites : [])|map(ex => ex.id ~ '') %}
    {% if (favorites is defined and favorites) or (recents is defined and recents) %}
    <div class="card-coach p-4 mb-4">
      <div class="text-xs tracking-widest uppercase text-muted mb-2">Ajout rapide</div>
      <div class="flex flex-wrap gap-2" id="quick-pick">
        {% for ex in favorites %}
          <span class="badge badge-lg gap-2 border-warning text-warning">
            <button type="button" class="quick-add" data-name="{{ ex.name|e('html_attr') }}">{{ ex.name }}</button>
            <button type="button" class="quick-fav" data-id="{{ ex.id }}" title="Retirer des favoris"><i class="bi bi-star-fill"></i></button>
          </span>
        {% endfor %}
        {% for ex in (recents is defined ? recents : []) %}
          {% if (ex.id ~ '') not in favIds %}
          <span class="badge badge-lg badge-ghost gap-2">
            <button type="button" class="quick-add" data-name="{{ ex.name|e('html_attr') }}">{{ ex.name }}</button>
            <button type="button" class="quick-fav" data-id="{{ ex.id }}" title="Ajouter aux favoris"><i class="bi bi-star"></i></button>
          </span>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {# ── Sets ────────────────────────────────────────────────────────────── #}
    <div class="card-coach p-6 mb-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-display text-xl text-muted-strong tracking-widest">SÉRIES</h2>
        <button type="button" id="add-set" class="btn btn-outline btn-primary btn-sm font-display tracking-widest">
          + AJOUTER SÉRIE
        </button>
      </div>

      <div id="sets-container">
        <div class="text-sm text-muted text-center py-6" id="empty-msg">
          Aucune série ajoutée. Clique sur "+ AJOUTER SÉRIE".
        </div>
      </div>
    </div>

    <div class="flex gap-4">
      <button type="submit" class="btn btn-primary flex-1 font-display text-lg tracking-widest">
        {{ isEdit ? 'METTRE À JOUR' : 'ENREGISTRER LA SÉANCE' }}
      </button>
      <a href="{{ isEdit ? path('app_session_show', {id: session.id}) : path('app_session_index') }}" class="btn btn-ghost">Annuler</a>
    </div>
  </form>
</div>

{# Liste partagée des exercices pour l'autocomplétion (tape pour filtrer) #}
<datalist id="exercise-options">
  {% for ex in exercises %}<option value="{{ ex.name|e('html_attr') }}">{% endfor %}
</datalist>

<script>
(function () {
const EXERCISES = [
  {% for ex in exercises %}{id: "{{ ex.id }}", name: "{{ ex.name|e('js') }}"},
  {% endfor %}
];
const EX_BY_NAME = {};
EXERCISES.forEach(e => { EX_BY_NAME[e.name.toLowerCase()] = e; });

{# Séries existantes (mode édition) #}
const EXISTING_SETS = [
  {% if isEdit %}{% for s in session.sets %}{
    exercise_name: "{{ s.exercise.name|e('js') }}",
    set_number: {{ s.setNumber }},
    reps: {{ s.reps }},
    weight_kg: "{{ s.weightKg is null ? '' : s.weightKg }}",
    rpe: "{{ s.rpe is null ? '' : s.rpe }}",
    is_warmup: {{ s.isWarmup ? 'true' : 'false' }}
  },
  {% endfor %}{% endif %}
];

let setIndex = 0;
const positionByName = {};

function positionFor(name) {
  if (positionByName[name] === undefined) {
    positionByName[name] = Object.keys(positionByName).length;
  }
  return positionByName[name];
}

function resolveExercise(input, idx) {
  const ex = EX_BY_NAME[input.value.trim().toLowerCase()];
  document.getElementById('exid-' + idx).value = ex ? ex.id : '';
  if (ex) {
    document.getElementById('pos-' + idx).value = positionFor(ex.name);
  }
  input.classList.toggle('border-error', !ex && input.value.trim() !== '');
}

function addSet(prefill) {
  document.getElementById('empty-msg')?.remove();
  const i = setIndex;
  const container = document.getElementById('sets-container');
  const div = document.createElement('div');
  div.className = 'border border-neutral rounded-lg p-4 mb-3 relative';
  div.dataset.index = i;

  div.innerHTML = `
    <div class="grid grid-cols-12 gap-2 items-end">
      <div class="col-span-12 md:col-span-5">
        <div class="text-xs tracking-widest uppercase text-muted mb-1">Exercice</div>
        <input type="text" list="exercise-options" autocomplete="off" placeholder="Tape pour chercher…"
               data-exercise-input
               class="input input-sm input-bordered bg-base-300 border-neutral focus:border-primary w-full text-xs">
        <input type="hidden" name="sets[${i}][exercise_id]" id="exid-${i}" required>
        <input type="hidden" name="sets[${i}][exercise_position]" id="pos-${i}" value="0">
      </div>
      <div class="col-span-4 md:col-span-1">
        <div class="text-xs tracking-widest uppercase text-muted mb-1">Série</div>
        <input type="number" name="sets[${i}][set_number]" value="1" min="1" max="20"
               class="input input-sm input-bordered bg-base-300 border-neutral w-full text-center">
      </div>
      <div class="col-span-4 md:col-span-1">
        <div class="text-xs tracking-widest uppercase text-muted mb-1">Reps</div>
        <input type="number" name="sets[${i}][reps]" value="0" min="0"
               class="input input-sm input-bordered bg-base-300 border-neutral w-full text-center" required>
      </div>
      <div class="col-span-4 md:col-span-2">
        <div class="text-xs tracking-widest uppercase text-muted mb-1">Poids (kg)</div>
        <input type="number" name="sets[${i}][weight_kg]" step="0.5" min="0" placeholder="—"
               class="input input-sm input-bordered bg-base-300 border-neutral w-full text-center">
      </div>
      <div class="col-span-4 md:col-span-1">
        <div class="text-xs tracking-widest uppercase text-muted mb-1">RPE</div>
        <input type="number" name="sets[${i}][rpe]" min="1" max="10" placeholder="—"
               class="input input-sm input-bordered bg-base-300 border-neutral w-full text-center">
      </div>
      <div class="col-span-4 md:col-span-1 text-center">
        <div class="text-xs tracking-widest uppercase text-muted mb-1">Échauff.</div>
        <input type="checkbox" name="sets[${i}][is_warmup]" value="1"
               class="checkbox checkbox-xs checkbox-primary mt-2">
      </div>
      <div class="col-span-4 md:col-span-1 flex justify-end">
        <button type="button" onclick="this.closest('[data-index]').remove()"
                class="btn btn-ghost btn-xs text-muted hover:text-error"><i class="bi bi-x-lg"></i></button>
      </div>
    </div>
  `;

  container.appendChild(div);
  div.querySelector('[data-exercise-input]').addEventListener('input', (e) => resolveExercise(e.target, i));

  if (prefill) {
    const q = (sel) => div.querySelector(sel);
    q('input[type="text"]').value = prefill.exercise_name || '';
    q(`input[name="sets[${i}][set_number]"]`).value = prefill.set_number ?? 1;
    q(`input[name="sets[${i}][reps]"]`).value = prefill.reps ?? 0;
    q(`input[name="sets[${i}][weight_kg]"]`).value = prefill.weight_kg ?? '';
    q(`input[name="sets[${i}][rpe]"]`).value = prefill.rpe ?? '';
    if (prefill.is_warmup) q('input[type="checkbox"]').checked = true;
    resolveExercise(q('input[type="text"]'), i);
  }

  setIndex++;
}

document.getElementById('add-set').addEventListener('click', () => addSet());

// Pré-remplissage en mode édition
EXISTING_SETS.forEach(s => addSet(s));

// Ajout rapide : favoris + récents
const quickPick = document.getElementById('quick-pick');
if (quickPick) {
  quickPick.addEventListener('click', async (e) => {
    const add = e.target.closest('.quick-add');
    if (add) { addSet({ exercise_name: add.dataset.name }); return; }
    const fav = e.target.closest('.quick-fav');
    if (fav) {
      try {
        const res = await fetch('/exercices/' + fav.dataset.id + '/favori', {
          method: 'POST', headers: { 'X-Requested-With': 'fetch' }
        });
        const data = await res.json();
        fav.innerHTML = data.favorite ? '<i class="bi bi-star-fill"></i>' : '<i class="bi bi-star"></i>';
      } catch (_) {}
    }
  });
}
})();
</script>
{% endblock %}
