{% extends 'base.html.twig' %}
{% block title %}Séances — CoachPro{% endblock %}

{% block body %}
<div class="px-6 md:px-8 py-8">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
    <div>
      <div class="section-tag mb-3">Training</div>
      <h1 class="font-display text-4xl md:text-5xl">MES SÉANCES</h1>
    </div>
    <a href="{{ path('app_session_new') }}" class="btn btn-primary font-display tracking-widest">
      + LOGGER UNE SÉANCE
    </a>
  </div>

  {# ── COACH IA ───────────────────────────────────────────────────────────── #}
  {% include '_coach_advice.html.twig' with { context: 'sessions' } %}

  {% if sessions is empty %}
    <div class="card-coach p-12 text-center">
      <div class="font-display text-3xl text-muted-strong mb-2">AUCUNE SÉANCE</div>
      <p class="text-sm text-muted mb-4">C'est l'heure de suer <i class="bi bi-trophy"></i></p>
      <a href="{{ path('app_session_new') }}" class="btn btn-primary btn-sm">Logger ma première séance</a>
    </div>
  {% else %}
    <div class="flex flex-col gap-3">
      {% for session in sessions %}
        <a href="{{ path('app_session_show', {id: session.id}) }}"
           class="card-coach p-5 flex items-center justify-between hover:bg-base-300 transition-colors group">
          <div class="flex items-center gap-5">
            <div class="text-center min-w-12">
              <div class="font-display text-2xl text-primary leading-none">{{ session.performedAt|date('d') }}</div>
              <div class="text-xs text-muted uppercase tracking-wide">{{ session.performedAt|date('M') }}</div>
            </div>
            <div>
              <div class="font-medium">{{ session.name }}</div>
              <div class="text-xs text-muted mt-0.5 flex gap-3">
                {% if session.durationMinutes %}
                  <span>⏱ {{ session.durationMinutes }} min</span>
                {% endif %}
                {% if session.rpe %}
                  <span>RPE {{ session.rpe }}/10</span>
                {% endif %}
                {% if session.sourceTemplate %}
                  <span class="text-primary">{{ session.sourceTemplate.name }}</span>
                {% endif %}
              </div>
            </div>
          </div>
          <div class="text-right">
            <div class="font-display text-3xl text-base-content">{{ session.sets|length }}</div>
            <div class="text-xs text-muted">séries</div>
          </div>
        </a>
      {% endfor %}
    </div>
  {% endif %}
</div>
{% endblock %}
