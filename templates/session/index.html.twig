{% extends 'base.html.twig' %}
{% block title %}Séances — CoachPro{% endblock %}

{% block body %}
<div class="px-8 py-8">
  <div class="flex items-center justify-between mb-8">
    <div>
      <div class="section-tag mb-3">Training</div>
      <h1 class="font-display text-5xl">MES SÉANCES</h1>
    </div>
    <a href="{{ path('app_session_new') }}" class="btn btn-primary font-display tracking-widest">
      + LOGGER UNE SÉANCE
    </a>
  </div>

  {% if sessions is empty %}
    <div class="card-dark p-12 text-center">
      <div class="font-display text-3xl text-gray-600 mb-2">AUCUNE SÉANCE</div>
      <p class="text-sm text-gray-500 mb-4">C'est l'heure de suer 💪</p>
      <a href="{{ path('app_session_new') }}" class="btn btn-primary btn-sm">Logger ma première séance</a>
    </div>
  {% else %}
    <div class="flex flex-col gap-3">
      {% for session in sessions %}
        <a href="{{ path('app_session_show', {id: session.id}) }}"
           class="card-dark p-5 flex items-center justify-between hover:bg-base-300 transition-colors group">
          <div class="flex items-center gap-5">
            <div class="text-center min-w-12">
              <div class="font-display text-2xl text-primary leading-none">{{ session.performedAt|date('d') }}</div>
              <div class="text-xs text-gray-500 uppercase tracking-wide">{{ session.performedAt|date('M') }}</div>
            </div>
            <div>
              <div class="font-medium">{{ session.name }}</div>
              <div class="text-xs text-gray-500 mt-0.5 flex gap-3">
                {% if session.durationMinutes %}
                  <span>⏱ {{ session.durationMinutes }} min</span>
                {% endif %}
                {% if session.rpe %}
                  <span>RPE {{ session.rpe }}/10</span>
                {% endif %}
                {% if session.sourceTemplate %}
                  <span class="text-primary">{{ session.sourceTemplate.name }}</span>
                {% endif %}
              </div>
            </div>
          </div>
          <div class="text-right">
            <div class="font-display text-3xl text-base-content">{{ session.sets|length }}</div>
            <div class="text-xs text-gray-500">séries</div>
          </div>
        </a>
      {% endfor %}
    </div>
  {% endif %}
</div>
{% endblock %}
