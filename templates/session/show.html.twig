{% extends 'base.html.twig' %}
{% block title %}{{ session.name }} — CoachPro{% endblock %}

{% block body %}
<div class="px-6 md:px-8 py-8">

  <div class="mb-6 flex items-center justify-between">
    <a href="{{ path('app_session_index') }}" class="text-xs text-muted hover:text-primary tracking-widest uppercase transition-colors">← Retour</a>
    <a href="{{ path('app_session_edit', {id: session.id}) }}" class="btn btn-outline btn-primary btn-sm font-display tracking-widest"><i class="bi bi-pencil"></i> Éditer</a>
  </div>

  <div class="flex flex-col md:flex-row md:items-start justify-between gap-4 mb-8">
    <div>
      <div class="section-tag mb-3">Séance</div>
      <h1 class="font-display text-4xl md:text-5xl">{{ session.name }}</h1>
      <div class="text-muted-strong mt-2 flex flex-wrap gap-4 text-sm">
        <span>{{ session.performedAt|date('l d F Y')|replace({
          'Monday':'Lundi','Tuesday':'Mardi','Wednesday':'Mercredi','Thursday':'Jeudi',
          'Friday':'Vendredi','Saturday':'Samedi','Sunday':'Dimanche',
          'January':'janvier','February':'février','March':'mars','April':'avril',
          'May':'mai','June':'juin','July':'juillet','August':'août',
          'September':'septembre','October':'octobre','November':'novembre','December':'décembre'
        })|upper }}</span>
        {% if session.durationMinutes %}<span>⏱ {{ session.durationMinutes }} min</span>{% endif %}
        {% if session.rpe %}<span>RPE {{ session.rpe }}/10</span>{% endif %}
      </div>
    </div>
    <div class="text-right">
      <div class="font-display text-5xl text-primary">{{ session.sets|length }}</div>
      <div class="text-xs text-muted uppercase tracking-widest">séries totales</div>
    </div>
  </div>

  {% if session.notes %}
    <div class="card-coach p-4 mb-6 text-sm text-muted-strong italic border-l-2 border-primary">
      {{ session.notes }}
    </div>
  {% endif %}

  {# Sets groupés par exercice #}
  {% if setsByExercise is empty %}
    <div class="card-coach p-12 text-center text-muted">Aucune série enregistrée.</div>
  {% else %}
    <div class="flex flex-col gap-4">
      {% for exerciseName, sets in setsByExercise %}
        <div class="card-coach overflow-hidden">
          <div class="px-5 py-3 border-b border-neutral flex items-center justify-between">
            <span class="font-medium">{{ exerciseName }}</span>
            <span class="text-xs text-muted tracking-widest uppercase">{{ sets|length }} série{{ sets|length > 1 ? 's' : '' }}</span>
          </div>
          <table class="table table-coachpro w-full">
            <thead>
              <tr class="border-b border-neutral">
                <th>Série</th>
                <th>Reps</th>
                <th>Poids</th>
                <th>RPE</th>
                <th>Type</th>
              </tr>
            </thead>
            <tbody>
              {% for set in sets %}
                <tr class="border-b border-neutral last:border-0">
                  <td class="text-muted">{{ set.setNumber }}</td>
                  <td><span class="font-display text-xl text-base-content">{{ set.reps }}</span></td>
                  <td>
                    {% if set.weightKg %}
                      <span class="font-display text-xl text-primary">{{ set.weightKg }}</span>
                      <span class="text-muted text-xs"> kg</span>
                    {% else %}
                      <span class="text-muted">Poids corps</span>
                    {% endif %}
                  </td>
                  <td>
                    {% if set.rpe %}
                      <span class="badge badge-outline badge-sm">{{ set.rpe }}/10</span>
                    {% else %}
                      <span class="text-muted">—</span>
                    {% endif %}
                  </td>
                  <td>
                    {% if set.warmup %}
                      <span class="badge badge-ghost badge-sm text-muted">Échauff.</span>
                    {% else %}
                      <span class="text-muted">—</span>
                    {% endif %}
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endfor %}
    </div>
  {% endif %}

</div>
{% endblock %}
