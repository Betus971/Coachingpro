{% extends 'base.html.twig' %}
{% block title %}{{ session.name }} — CoachPro{% endblock %}

{% block body %}
<div class="px-8 py-8">

  <div class="mb-6">
    <a href="{{ path('app_session_index') }}" class="text-xs text-gray-500 hover:text-primary tracking-widest uppercase">← Retour</a>
  </div>

  <div class="flex items-start justify-between mb-8">
    <div>
      <div class="section-tag mb-3">Séance</div>
      <h1 class="font-display text-5xl">{{ session.name }}</h1>
      <div class="text-gray-400 mt-2 flex gap-4 text-sm">
        <span>{{ session.performedAt|date('l d MMMM Y')|upper }}</span>
        {% if session.durationMinutes %}<span>⏱ {{ session.durationMinutes }} min</span>{% endif %}
        {% if session.rpe %}<span>RPE {{ session.rpe }}/10</span>{% endif %}
      </div>
    </div>
    <div class="text-right">
      <div class="font-display text-5xl text-primary">{{ session.sets|length }}</div>
      <div class="text-xs text-gray-500 uppercase tracking-widest">séries totales</div>
    </div>
  </div>

  {% if session.notes %}
    <div class="card-dark p-4 mb-6 text-sm text-gray-400 italic border-l-2 border-primary">
      {{ session.notes }}
    </div>
  {% endif %}

  {# Sets groupés par exercice #}
  {% if setsByExercise is empty %}
    <div class="card-dark p-12 text-center text-gray-600">Aucune série enregistrée.</div>
  {% else %}
    <div class="flex flex-col gap-4">
      {% for exerciseName, sets in setsByExercise %}
        <div class="card-dark overflow-hidden">
          <div class="px-5 py-3 border-b border-neutral flex items-center justify-between">
            <span class="font-medium">{{ exerciseName }}</span>
            <span class="text-xs text-gray-500 tracking-widest uppercase">{{ sets|length }} série{{ sets|length > 1 ? 's' : '' }}</span>
          </div>
          <table class="table table-coachpro w-full">
            <thead>
              <tr class="border-b border-neutral">
                <th>Série</th>
                <th>Reps</th>
                <th>Poids</th>
                <th>RPE</th>
                <th>Type</th>
              </tr>
            </thead>
            <tbody>
              {% for set in sets %}
                <tr class="border-b border-neutral last:border-0">
                  <td class="text-gray-500">{{ set.setNumber }}</td>
                  <td><span class="font-display text-xl text-base-content">{{ set.reps }}</span></td>
                  <td>
                    {% if set.weightKg %}
                      <span class="font-display text-xl text-primary">{{ set.weightKg }}</span>
                      <span class="text-gray-500 text-xs"> kg</span>
                    {% else %}
                      <span class="text-gray-600">Poids corps</span>
                    {% endif %}
                  </td>
                  <td>
                    {% if set.rpe %}
                      <span class="badge badge-outline badge-sm">{{ set.rpe }}/10</span>
                    {% else %}
                      <span class="text-gray-600">—</span>
                    {% endif %}
                  </td>
                  <td>
                    {% if set.warmup %}
                      <span class="badge badge-ghost badge-sm text-gray-500">Échauff.</span>
                    {% else %}
                      <span class="text-gray-600">—</span>
                    {% endif %}
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endfor %}
    </div>
  {% endif %}

</div>
{% endblock %}
