{% extends 'base.html.twig' %}
{% block title %}{{ participation.challenge.emoji }} {{ participation.challenge.title }} — CoachPro{% endblock %}

{% block body %}

{# ── Animations CSS ───────────────────────────────────────────────────────── #}
<style>
/* ─── particules ─────────────────────────────────────────────── */
@keyframes challengeParticleFly {
  0%   { transform: translate(0,0) scale(1); opacity: 1; }
  100% { transform: translate(var(--dx),var(--dy)) scale(0); opacity: 0; }
}

/* ─── pop bouton ─────────────────────────────────────────────── */
@keyframes anim-pop {
  0%   { transform: scale(1); }
  35%  { transform: scale(1.4) rotate(-5deg); }
  65%  { transform: scale(.88) rotate(3deg); }
  100% { transform: scale(1); }
}
.anim-pop { animation: anim-pop .45s cubic-bezier(.36,.07,.19,.97) both; }

/* ─── streak pop ─────────────────────────────────────────────── */
@keyframes anim-streak-pop {
  0%   { transform: scale(1); color: inherit; }
  50%  { transform: scale(1.6); color: #f59e0b; }
  100% { transform: scale(1); color: inherit; }
}
.anim-streak-pop { animation: anim-streak-pop .4s ease both; }

/* ─── banner slide-down ──────────────────────────────────────── */
@keyframes slideDown {
  from { transform: translateY(-30px); opacity: 0; }
  to   { transform: translateY(0);     opacity: 1; }
}
.anim-pop.completion-banner { animation: slideDown .5s ease both; }

/* ─── boutons calendrier ─────────────────────────────────────── */
.day-btn {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  border-radius: .75rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: .7rem;
  font-weight: 700;
  cursor: pointer;
  transition: transform .15s, box-shadow .15s;
  border: 2px solid transparent;
  line-height: 1;
  gap: 1px;
  user-select: none;
}
.day-btn:hover:not(:disabled) { transform: scale(1.07); }
.day-btn:active:not(:disabled){ transform: scale(.95); }

/* état neutre (accessible, non coché) */
.day-unchecked {
  background: hsl(var(--b3));
  border-color: hsl(var(--bc)/.15);
  color: hsl(var(--bc)/.7);
}
.day-unchecked:hover:not(:disabled) {
  border-color: hsl(var(--p)/.5);
  box-shadow: 0 0 0 3px hsl(var(--p)/.15);
}

/* état coché */
.day-checked {
  background: linear-gradient(135deg, hsl(var(--su)), hsl(var(--su)/.7));
  border-color: hsl(var(--su));
  color: hsl(var(--suc));
  box-shadow: 0 2px 10px hsl(var(--su)/.35);
}

/* case milestone cochée */
.day-milestone.day-checked {
  background: linear-gradient(135deg, #f59e0b, #ef4444);
  border-color: #f59e0b;
  color: #fff;
  box-shadow: 0 3px 14px rgba(245,158,11,.5);
}

/* jour futur (verrouillé) */
.day-locked {
  background: hsl(var(--b2));
  border-color: transparent;
  color: hsl(var(--bc)/.2);
  cursor: default;
}

/* indicateur "aujourd'hui" */
.day-today .day-num::after {
  content: '';
  display: block;
  width: 4px; height: 4px;
  border-radius: 50%;
  background: hsl(var(--p));
  margin: 2px auto 0;
}

/* tick check */
.day-tick {
  font-size: .85em;
  line-height: 1;
}

/* ─── badge milestone ─────────────────────────────────────────── */
.milestone-ring {
  box-shadow: 0 0 0 2px #f59e0b, 0 0 0 4px hsl(var(--b1));
}

/* ─── progress bar ────────────────────────────────────────────── */
.progress-fill {
  transition: width .6s cubic-bezier(.4,0,.2,1);
  background: linear-gradient(90deg, #f59e0b, #ef4444);
}
</style>

{# ── Back link ────────────────────────────────────────────────────────────── #}
<div class="mb-5">
  <a href="{{ path('app_challenge_index') }}" class="btn btn-ghost btn-sm gap-2">
    ← Tous les défis
  </a>
</div>

{# ── Completion banner (hidden until JS shows it) ─────────────────────────── #}
{% if participation.status == 'completed' %}
  <div data-challenge-target="completionBanner"
       class="alert bg-gradient-to-r from-warning to-error text-white font-bold text-center text-lg mb-6 rounded-2xl shadow-xl">
    🏆 DÉFI COMPLÉTÉ — Tu es une LÉGENDE ! 🏆
  </div>
{% else %}
  <div data-challenge-target="completionBanner"
       class="hidden alert bg-gradient-to-r from-warning to-error text-white font-bold text-center text-lg mb-6 rounded-2xl shadow-xl">
    🏆 DÉFI COMPLÉTÉ — Tu es une LÉGENDE ! 🏆
  </div>
{% endif %}

{# ── Challenge header ──────────────────────────────────────────────────────── #}
<div class="card bg-base-100 shadow-lg border border-base-300 mb-6"
     data-controller="challenge"
     data-challenge-participation-id-value="{{ participation.id }}">

  <div class="card-body p-6">
    <div class="flex flex-col sm:flex-row sm:items-center gap-4 mb-6">
      <div class="text-6xl leading-none">{{ participation.challenge.emoji }}</div>
      <div class="flex-1">
        <h1 class="text-2xl font-extrabold">{{ participation.challenge.title }}</h1>
        <p class="text-base-content/60 mt-1 text-sm">{{ participation.challenge.description }}</p>
        <div class="mt-2">
          {% if participation.status == 'active' %}
            <span class="badge badge-success badge-sm">En cours</span>
          {% elseif participation.status == 'completed' %}
            <span class="badge badge-warning badge-sm">Complété ✓</span>
          {% else %}
            <span class="badge badge-error badge-sm">Abandonné</span>
          {% endif %}
          <span class="badge badge-ghost badge-sm ml-1">Démarré le {{ participation.startedAt|date('d/m/Y') }}</span>
        </div>
      </div>
    </div>

    {# ── Stats row ────────────────────────────────────────────────────────── #}
    <div class="grid grid-cols-3 gap-3 mb-6">
      <div class="bg-base-200 rounded-xl p-3 text-center">
        <div class="text-3xl font-black text-warning"
             data-challenge-target="streakCount">{{ streak }}</div>
        <div class="text-xs text-base-content/50 mt-0.5">🔥 Série</div>
      </div>
      <div class="bg-base-200 rounded-xl p-3 text-center">
        <div class="text-3xl font-black text-success"
             data-challenge-target="checkedCount">{{ checkedCount }}</div>
        <div class="text-xs text-base-content/50 mt-0.5">✅ Jours cochés</div>
      </div>
      <div class="bg-base-200 rounded-xl p-3 text-center">
        <div class="text-3xl font-black text-info">{{ participation.daysRemaining }}</div>
        <div class="text-xs text-base-content/50 mt-0.5">📅 Restants</div>
      </div>
    </div>

    {# ── Progress bar ──────────────────────────────────────────────────────── #}
    <div class="mb-6">
      <div class="flex justify-between text-sm font-semibold mb-2">
        <span>Progression</span>
        <span data-challenge-target="progressText">{{ progress }}%</span>
      </div>
      <div class="w-full bg-base-300 rounded-full h-4 overflow-hidden">
        <div data-challenge-target="progressBar"
             class="progress-fill h-4 rounded-full"
             style="width: {{ progress }}%"></div>
      </div>
      <div class="flex justify-between text-xs text-base-content/40 mt-1">
        <span>Début</span>
        <span>Jour 7 🔥</span>
        <span>Jour 14 ⭐</span>
        <span>Jour 21 💪</span>
        <span>Fin 🏆</span>
      </div>
    </div>

    {# ── Calendar grid ─────────────────────────────────────────────────────── #}
    <div class="grid grid-cols-5 sm:grid-cols-6 md:grid-cols-10 gap-2" id="challenge-calendar">
      {% for d, info in days %}
        {% set btnClass = 'day-btn' %}
        {% set btnClass = btnClass ~ (info.milestone ? ' day-milestone' : '') %}
        {% set btnClass = btnClass ~ (info.today     ? ' day-today' : '') %}

        {% if not info.accessible %}
          {# Futur — verrouillé #}
          <button class="{{ btnClass }} day-locked" disabled title="Pas encore accessible">
            <span class="day-num">{{ d }}</span>
            {% if info.milestone %}<span style="font-size:.6em;opacity:.3">★</span>{% endif %}
          </button>

        {% elseif info.checked %}
          {# Coché #}
          <button class="{{ btnClass }} day-checked"
                  data-day="{{ d }}"
                  data-checked="1"
                  data-challenge-target="dayBtn"
                  data-action="click->challenge#checkDay"
                  {% if participation.status != 'active' %}disabled{% endif %}
                  title="Jour {{ d }} — coché ✓">
            <span class="day-num">{{ d }}</span>
            <span class="day-tick">✓</span>
          </button>

        {% else %}
          {# Accessible mais non coché #}
          <button class="{{ btnClass }} day-unchecked"
                  data-day="{{ d }}"
                  data-checked="0"
                  data-challenge-target="dayBtn"
                  data-action="click->challenge#checkDay"
                  {% if participation.status != 'active' %}disabled{% endif %}
                  title="Jour {{ d }} — cliquer pour cocher">
            <span class="day-num">{{ d }}</span>
            {% if info.milestone %}<span style="font-size:.6em;opacity:.5">★</span>{% endif %}
          </button>
        {% endif %}
      {% endfor %}
    </div>

    {# ── Légende ───────────────────────────────────────────────────────────── #}
    <div class="flex flex-wrap gap-3 mt-4 text-xs text-base-content/50">
      <span class="flex items-center gap-1.5">
        <span class="inline-block w-4 h-4 rounded bg-base-300 border border-base-content/15"></span> À faire
      </span>
      <span class="flex items-center gap-1.5">
        <span class="inline-block w-4 h-4 rounded"
              style="background:linear-gradient(135deg,hsl(var(--su)),hsl(var(--su)/.7))"></span> Coché ✓
      </span>
      <span class="flex items-center gap-1.5">
        <span class="inline-block w-4 h-4 rounded"
              style="background:linear-gradient(135deg,#f59e0b,#ef4444)"></span> Milestone 🏆
      </span>
      <span class="flex items-center gap-1.5">
        <span class="inline-block w-4 h-4 rounded bg-base-200 opacity-30"></span> Futur
      </span>
    </div>
  </div>
</div>

{# ── Abandon ───────────────────────────────────────────────────────────────── #}
{% if participation.status == 'active' %}
  <div class="flex justify-end mt-2">
    <form method="post" action="{{ path('app_challenge_abandon', {id: participation.id}) }}"
          onsubmit="return confirm('Abandonner ce défi ? Tu peux toujours en recommencer un !')">
      <button type="submit" class="btn btn-ghost btn-sm text-error gap-1">
        🏳 Abandonner le défi
      </button>
    </form>
  </div>
{% endif %}

{% endblock %}
