{% extends 'base.html.twig' %}
{% block title %}Défis — CoachPro{% endblock %}

{% set catMeta = {
  'nutrition': {icon: 'bi-egg-fried',   label: 'Nutrition', color: 'badge-success'},
  'fitness':   {icon: 'bi-heart-pulse', label: 'Fitness',   color: 'badge-warning'},
  'lifestyle': {icon: 'bi-tree',        label: 'Lifestyle', color: 'badge-secondary'},
  'mindset':   {icon: 'bi-lightbulb',   label: 'Mindset',   color: 'badge-info'},
} %}
{% macro chIcon(category, size) %}
  {% set m = {'nutrition':'bi-egg-fried','fitness':'bi-heart-pulse','lifestyle':'bi-tree','mindset':'bi-lightbulb'} %}
  <span class="rounded-2xl bg-primary/10 text-primary flex items-center justify-center shrink-0 {{ size }}">
    <i class="bi {{ m[category] ?? 'bi-trophy' }}"></i>
  </span>
{% endmacro %}
{% import _self as ch %}

{% block body %}
<div class="px-4 md:px-8 py-8 max-w-5xl mx-auto">

  {# Header #}
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-8">
    <div>
      <div class="section-tag green mb-3">Défis</div>
      <h1 class="font-display text-4xl md:text-5xl">RELÈVE UN DÉFI</h1>
      <p class="text-sm text-muted mt-2">Coche chaque jour, construis une habitude.</p>
    </div>
    <div class="flex items-center gap-3">
      {% if active|length > 0 %}
        <div class="badge badge-warning badge-lg font-bold">{{ active|length }} en cours</div>
      {% endif %}
      <label for="modal-create-challenge" class="btn btn-secondary font-display tracking-widest gap-2">
        <i class="bi bi-plus-lg"></i> Créer mon défi
      </label>
    </div>
  </div>

  {# Modal création #}
  <input type="checkbox" id="modal-create-challenge" class="modal-toggle"/>
  <div class="modal modal-bottom sm:modal-middle" role="dialog">
    <div class="modal-box max-w-lg bg-base-200 border border-neutral">
      <label for="modal-create-challenge" class="btn btn-sm btn-circle btn-ghost absolute right-3 top-3"><i class="bi bi-x-lg"></i></label>
      <h3 class="font-display text-2xl mb-1">CRÉER MON DÉFI</h3>
      <p class="text-sm text-muted mb-5">Définis ta règle, ta durée, et go.</p>

      <form method="post" action="{{ path('app_challenge_create') }}" class="space-y-4">
        <div>
          <label class="label-text text-xs uppercase tracking-widest text-muted">Titre du défi <span class="text-error">*</span></label>
          <input type="text" name="title" required maxlength="100" placeholder="ex : Pas de sucre pendant 21 jours"
                 class="input input-bordered w-full bg-base-100 mt-1">
        </div>

        <div>
          <label class="label-text text-xs uppercase tracking-widest text-muted">Description (optionnel)</label>
          <textarea name="description" rows="2" maxlength="500" placeholder="Ta règle, pourquoi tu le fais…"
                    class="textarea textarea-bordered w-full bg-base-100 resize-none mt-1"></textarea>
        </div>

        <div>
          <label class="label-text text-xs uppercase tracking-widest text-muted">Durée</label>
          <div class="flex flex-wrap gap-2 mt-1" id="duration-pills">
            {% for d in [7, 14, 21, 30, 60, 90] %}
              <label class="cursor-pointer">
                <input type="radio" name="duration" value="{{ d }}" class="hidden peer" {{ d == 30 ? 'checked' : '' }}>
                <span class="badge badge-lg peer-checked:badge-primary peer-checked:font-bold transition-colors">{{ d }}j</span>
              </label>
            {% endfor %}
            <label class="cursor-pointer">
              <input type="radio" name="duration" value="custom" id="duration-custom-radio" class="hidden peer">
              <span class="badge badge-lg peer-checked:badge-primary peer-checked:font-bold transition-colors">Autre</span>
            </label>
            <input type="number" id="duration-custom-input" name="duration_custom" min="1" max="365" placeholder="nb jours"
                   class="input input-bordered input-sm w-24 hidden bg-base-100">
          </div>
        </div>

        <div>
          <label class="label-text text-xs uppercase tracking-widest text-muted">Catégorie</label>
          <div class="flex flex-wrap gap-2 mt-1">
            {% for val, m in catMeta %}
              <label class="cursor-pointer">
                <input type="radio" name="category" value="{{ val }}" class="hidden peer" {{ val == 'lifestyle' ? 'checked' : '' }}>
                <span class="badge badge-lg gap-1 peer-checked:badge-secondary peer-checked:font-bold transition-colors">
                  <i class="bi {{ m.icon }}"></i> {{ m.label }}
                </span>
              </label>
            {% endfor %}
          </div>
        </div>

        <div class="modal-action mt-6 pt-4 border-t border-base-300">
          <label for="modal-create-challenge" class="btn btn-ghost">Annuler</label>
          <button type="submit" class="btn btn-primary font-display tracking-widest gap-2"><i class="bi bi-flag-fill"></i> Lancer le défi</button>
        </div>
      </form>
    </div>
    <label class="modal-backdrop" for="modal-create-challenge"></label>
  </div>

  <script>
  (function () {
    const radio = document.getElementById('duration-custom-radio');
    const input = document.getElementById('duration-custom-input');
    const form  = radio?.closest('form');
    radio?.addEventListener('change', () => { input.classList.toggle('hidden', !radio.checked); if (radio.checked) input.focus(); });
    document.querySelectorAll('#duration-pills input[type=radio]:not(#duration-custom-radio)')
      .forEach(r => r.addEventListener('change', () => input.classList.add('hidden')));
    form?.addEventListener('submit', () => { if (radio?.checked && input.value) radio.value = input.value; });
  })();
  </script>

  {# Défis en cours #}
  {% if active|length > 0 %}
    <section class="mb-10">
      <h2 class="font-display text-2xl mb-4 flex items-center gap-2"><i class="bi bi-lightning-charge-fill text-warning"></i> Mes défis en cours</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {% for p in active %}
          {% set pct = p.progressPercent %}
          <a href="{{ path('app_challenge_show', {id: p.id}) }}"
             class="card bg-base-100 border border-warning/40 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all">
            <div class="card-body p-5">
              <div class="flex items-start justify-between gap-2">
                <div class="flex items-center gap-2">
                  {{ ch.chIcon(p.challenge.category, 'w-10 h-10 text-xl') }}
                  {% if not p.challenge.preset %}<span class="badge badge-ghost badge-xs">Perso</span>{% endif %}
                </div>
                <div class="text-right shrink-0">
                  <div class="text-2xl font-display text-warning">{{ p.currentStreak }}</div>
                  <div class="text-xs text-muted"><i class="bi bi-fire"></i> série</div>
                </div>
              </div>
              <h3 class="font-bold mt-2">{{ p.challenge.title }}</h3>
              <div class="mt-3">
                <div class="flex justify-between text-xs text-muted mb-1">
                  <span>{{ p.checkIns|length }} / {{ p.challenge.durationDays }} jours</span><span>{{ pct }}%</span>
                </div>
                <div class="w-full bg-base-300 rounded-full h-2.5 overflow-hidden">
                  <div class="h-2.5 rounded-full bg-gradient-to-r from-warning to-error transition-all duration-500" style="width: {{ pct }}%"></div>
                </div>
              </div>
              <div class="mt-2 text-xs text-muted">{{ p.daysRemaining }} jour{{ p.daysRemaining > 1 ? 's' : '' }} restant{{ p.daysRemaining > 1 ? 's' : '' }}</div>
            </div>
          </a>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {# Mes défis perso #}
  {% if custom|length > 0 %}
    <section class="mb-10">
      <h2 class="font-display text-2xl mb-4 flex items-center gap-2"><i class="bi bi-stars text-primary"></i> Mes défis perso</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {% for challenge in custom %}
          {% set isActive = challenge.id.toRfc4122 in activeIds %}
          <div class="card bg-base-100 shadow-sm border border-primary/30 {{ isActive ? 'opacity-60' : 'hover:shadow-md hover:-translate-y-0.5 transition-all' }}">
            <div class="card-body p-5">
              <div class="flex items-center gap-3 mb-2">
                {{ ch.chIcon(challenge.category, 'w-12 h-12 text-2xl') }}
                <div class="flex-1 min-w-0">
                  <h3 class="font-bold leading-tight truncate">{{ challenge.title }}</h3>
                  <span class="badge badge-ghost badge-xs mt-0.5">{{ challenge.durationDays }} jours</span>
                </div>
              </div>
              {% if challenge.description %}<p class="text-sm text-muted mb-4">{{ challenge.description }}</p>{% endif %}
              {% if isActive %}
                <div class="btn btn-sm btn-disabled w-full"><i class="bi bi-check2"></i> En cours</div>
              {% else %}
                <form method="post" action="{{ path('app_challenge_join', {id: challenge.id}) }}">
                  <button type="submit" class="btn btn-sm btn-primary w-full gap-2"><i class="bi bi-arrow-repeat"></i> Relancer</button>
                </form>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {# Catalogue #}
  <section class="mb-10">
    <h2 class="font-display text-2xl mb-4 flex items-center gap-2"><i class="bi bi-grid-3x3-gap-fill text-primary"></i> Catalogue de défis</h2>

    {% set grouped = {} %}
    {% for c in challenges %}
      {% set cat = c.category %}
      {% if grouped[cat] is not defined %}{% set grouped = grouped|merge({(cat): []}) %}{% endif %}
      {% set grouped = grouped|merge({(cat): grouped[cat]|merge([c])}) %}
    {% endfor %}

    {% for cat, items in grouped %}
      {% set m = catMeta[cat] ?? {icon: 'bi-trophy', label: cat, color: 'badge-neutral'} %}
      <div class="mb-6">
        <div class="flex items-center gap-2 mb-3">
          <span class="badge {{ m.color }} badge-sm font-semibold gap-1"><i class="bi {{ m.icon }}"></i> {{ m.label }}</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {% for challenge in items %}
            {% set isActive = challenge.id.toRfc4122 in activeIds %}
            <div class="card bg-base-100 shadow-sm border border-base-300 {{ isActive ? 'opacity-70' : 'hover:shadow-md hover:-translate-y-0.5 transition-all' }}">
              <div class="card-body p-5">
                <div class="flex items-center gap-3 mb-2">
                  {{ ch.chIcon(challenge.category, 'w-12 h-12 text-2xl') }}
                  <div>
                    <h3 class="font-bold leading-tight">{{ challenge.title }}</h3>
                    <span class="badge badge-ghost badge-xs mt-0.5">{{ challenge.durationDays }} jours</span>
                  </div>
                </div>
                <p class="text-sm text-muted mb-4">{{ challenge.description }}</p>
                {% if isActive %}
                  <div class="btn btn-sm btn-disabled w-full"><i class="bi bi-check2"></i> En cours</div>
                {% else %}
                  <form method="post" action="{{ path('app_challenge_join', {id: challenge.id}) }}">
                    <button type="submit" class="btn btn-sm btn-primary w-full gap-2"><i class="bi bi-flag-fill"></i> Relever le défi</button>
                  </form>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endfor %}
  </section>

  {# Historique #}
  {% if history|length > 0 %}
    <section>
      <h2 class="font-display text-2xl mb-4 flex items-center gap-2"><i class="bi bi-clock-history text-muted"></i> Historique</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {% for p in history %}
          <div class="card bg-base-100 shadow-sm border border-base-200 opacity-75">
            <div class="card-body p-4 flex flex-row items-center gap-3">
              {{ ch.chIcon(p.challenge.category, 'w-10 h-10 text-lg') }}
              <div class="flex-1 min-w-0">
                <div class="font-semibold text-sm truncate">{{ p.challenge.title }}</div>
                <div class="text-xs text-muted">
                  {{ p.checkIns|length }} / {{ p.challenge.durationDays }} jours ·
                  {% if p.status == 'completed' %}<span class="text-success font-semibold">Complété</span>{% else %}<span class="text-error">Abandonné</span>{% endif %}
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </section>
  {% endif %}

</div>
{% endblock %}
