{% extends 'base.html.twig' %}
{% block title %}Défis — CoachPro{% endblock %}

{% block body %}

{# ── CSS ─────────────────────────────────────────────────────────────────── #}
<style>
@keyframes anim-pop {
  0%   { transform: scale(1); }
  35%  { transform: scale(1.35) rotate(-4deg); }
  65%  { transform: scale(.9) rotate(3deg); }
  100% { transform: scale(1); }
}
.anim-pop { animation: anim-pop .5s ease both; }
</style>

{# ── Header ──────────────────────────────────────────────────────────────── #}
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-8">
  <div>
    <h1 class="text-3xl font-extrabold tracking-tight">Défis 🔥</h1>
    <p class="text-base-content/60 mt-1">Relève un défi, coche chaque jour, construis une habitude.</p>
  </div>
  <div class="flex items-center gap-3">
    {% if active|length > 0 %}
      <div class="badge badge-warning badge-lg gap-1 font-bold">
        🎯 {{ active|length }} en cours
      </div>
    {% endif %}
    {# ── Bouton Créer mon défi ── #}
    <label for="modal-create-challenge" class="btn btn-primary gap-2 font-bold">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
      </svg>
      Créer mon défi
    </label>
  </div>
</div>

{# ── Modal : Créer un défi personnalisé ──────────────────────────────────── #}
<input type="checkbox" id="modal-create-challenge" class="modal-toggle"/>
<div class="modal modal-bottom sm:modal-middle" role="dialog">
  <div class="modal-box max-w-lg">
    <label for="modal-create-challenge"
           class="btn btn-sm btn-circle btn-ghost absolute right-3 top-3">✕</label>
    <h3 class="text-xl font-extrabold mb-1">Créer mon propre défi ✨</h3>
    <p class="text-sm text-base-content/60 mb-5">Définis ta règle, ta durée, et go.</p>

    <form method="post" action="{{ path('app_challenge_create') }}" class="space-y-4">

      {# Emoji + Titre #}
      <div class="flex gap-2 items-start">
        <div>
          <label class="label label-text text-xs pb-1">Emoji</label>
          <input type="text" name="emoji" value="🎯"
                 maxlength="4" placeholder="🎯"
                 class="input input-bordered w-16 text-center text-2xl"
                 title="Colle ou tape un emoji">
        </div>
        <div class="flex-1">
          <label class="label label-text text-xs pb-1">Titre du défi <span class="text-error">*</span></label>
          <input type="text" name="title" required maxlength="100"
                 placeholder="ex : Pas de café pendant 21 jours"
                 class="input input-bordered w-full">
        </div>
      </div>

      {# Description #}
      <div>
        <label class="label label-text text-xs pb-1">Description (optionnel)</label>
        <textarea name="description" rows="2" maxlength="500"
                  placeholder="Décris ta règle, pourquoi tu le fais..."
                  class="textarea textarea-bordered w-full resize-none"></textarea>
      </div>

      {# Durée #}
      <div>
        <label class="label label-text text-xs pb-1">Durée</label>
        <div class="flex flex-wrap gap-2" id="duration-pills">
          {% for d in [7, 14, 21, 30, 60, 90] %}
            <label class="cursor-pointer">
              <input type="radio" name="duration" value="{{ d }}"
                     class="hidden peer" {{ d == 30 ? 'checked' : '' }}>
              <span class="badge badge-lg peer-checked:badge-primary peer-checked:font-bold transition-colors">
                {{ d }}j
              </span>
            </label>
          {% endfor %}
          <label class="cursor-pointer flex items-center gap-1.5">
            <input type="radio" name="duration" value="custom" id="duration-custom-radio" class="hidden peer">
            <span class="badge badge-lg peer-checked:badge-primary peer-checked:font-bold transition-colors">
              Autre
            </span>
          </label>
          <input type="number" id="duration-custom-input" name="duration_custom"
                 min="1" max="365" placeholder="nb jours"
                 class="input input-bordered input-sm w-24 hidden">
        </div>
      </div>

      {# Catégorie #}
      <div>
        <label class="label label-text text-xs pb-1">Catégorie</label>
        <div class="flex flex-wrap gap-2">
          {% for val, label in {'nutrition': '🥗 Nutrition', 'fitness': '💪 Fitness', 'lifestyle': '🌿 Lifestyle', 'mindset': '🧘 Mindset'} %}
            <label class="cursor-pointer">
              <input type="radio" name="category" value="{{ val }}"
                     class="hidden peer" {{ val == 'lifestyle' ? 'checked' : '' }}>
              <span class="badge badge-lg peer-checked:badge-secondary peer-checked:font-bold transition-colors">
                {{ label }}
              </span>
            </label>
          {% endfor %}
        </div>
      </div>

      <div class="modal-action mt-6 pt-4 border-t border-base-300">
        <label for="modal-create-challenge" class="btn btn-ghost">Annuler</label>
        <button type="submit" class="btn btn-primary gap-2 font-bold">
          🚀 Lancer le défi
        </button>
      </div>
    </form>
  </div>
  <label class="modal-backdrop" for="modal-create-challenge"></label>
</div>

{# Script : champ durée personnalisé #}
<script>
(function () {
  const radio  = document.getElementById('duration-custom-radio');
  const input  = document.getElementById('duration-custom-input');
  const form   = radio?.closest('form');

  radio?.addEventListener('change', () => {
    input.classList.toggle('hidden', !radio.checked);
    if (radio.checked) input.focus();
  });

  document.querySelectorAll('#duration-pills input[type=radio]:not(#duration-custom-radio)')
    .forEach(r => r.addEventListener('change', () => {
      input.classList.add('hidden');
    }));

  form?.addEventListener('submit', () => {
    if (radio?.checked && input.value) {
      // Override the "custom" value with the actual number
      radio.value = input.value;
    }
  });
})();
</script>

{# ── Défis actifs ─────────────────────────────────────────────────────────── #}
{% if active|length > 0 %}
  <section class="mb-10">
    <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
      <span class="text-2xl">⚡</span> Mes défis en cours
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {% for p in active %}
        {% set pct = p.progressPercent %}
        <a href="{{ path('app_challenge_show', {id: p.id}) }}"
           class="card bg-base-100 border-2 border-warning/40 shadow hover:shadow-lg hover:-translate-y-0.5 transition-all group">
          <div class="card-body p-5">
            <div class="flex items-start justify-between gap-2">
              <div>
                <div class="flex items-center gap-2">
                  <span class="text-3xl">{{ p.challenge.emoji }}</span>
                  {% if not p.challenge.preset %}
                    <span class="badge badge-ghost badge-xs">Perso</span>
                  {% endif %}
                </div>
                <h3 class="font-bold mt-1 group-hover:text-warning transition-colors">{{ p.challenge.title }}</h3>
              </div>
              <div class="text-right shrink-0">
                <div class="text-2xl font-black text-warning">{{ p.currentStreak }}</div>
                <div class="text-xs text-base-content/50">🔥 série</div>
              </div>
            </div>
            <div class="mt-3">
              <div class="flex justify-between text-xs text-base-content/60 mb-1">
                <span>{{ p.checkIns|length }} / {{ p.challenge.durationDays }} jours</span>
                <span>{{ pct }}%</span>
              </div>
              <div class="w-full bg-base-300 rounded-full h-2.5 overflow-hidden">
                <div class="h-2.5 rounded-full bg-gradient-to-r from-warning to-error transition-all duration-500"
                     style="width: {{ pct }}%"></div>
              </div>
            </div>
            <div class="mt-2 text-xs text-base-content/50">
              Démarré le {{ p.startedAt|date('d/m/Y') }} ·
              {{ p.daysRemaining }} jour{{ p.daysRemaining > 1 ? 's' : '' }} restant{{ p.daysRemaining > 1 ? 's' : '' }}
            </div>
          </div>
        </a>
      {% endfor %}
    </div>
  </section>
{% endif %}

{# ── Mes défis personnels ─────────────────────────────────────────────────── #}
{% if custom|length > 0 %}
  <section class="mb-10">
    <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
      <span class="text-2xl">🛠</span> Mes défis perso
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {% for challenge in custom %}
        {% set isActive = challenge.id.toRfc4122 in activeIds %}
        <div class="card bg-base-100 shadow border border-primary/30 {{ isActive ? 'opacity-60' : 'hover:shadow-md hover:-translate-y-0.5 transition-all' }}">
          <div class="card-body p-5">
            <div class="flex items-center gap-3 mb-2">
              <span class="text-4xl">{{ challenge.emoji }}</span>
              <div class="flex-1 min-w-0">
                <h3 class="font-bold leading-tight truncate">{{ challenge.title }}</h3>
                <span class="badge badge-ghost badge-xs mt-0.5">{{ challenge.durationDays }} jours</span>
              </div>
            </div>
            {% if challenge.description %}
              <p class="text-sm text-base-content/60 mb-4">{{ challenge.description }}</p>
            {% endif %}
            {% if isActive %}
              <div class="btn btn-sm btn-disabled w-full">✓ En cours</div>
            {% else %}
              <form method="post" action="{{ path('app_challenge_join', {id: challenge.id}) }}">
                <button type="submit" class="btn btn-sm btn-primary w-full gap-2 font-bold">
                  🚀 Relancer
                </button>
              </form>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </section>
{% endif %}

{# ── Catalogue des défis présets ─────────────────────────────────────────── #}
<section class="mb-10">
  <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
    <span class="text-2xl">🎯</span> Défis du catalogue
  </h2>

  {% set categories = {
    'nutrition': { label: 'Nutrition', icon: '🥗', color: 'badge-success' },
    'fitness':   { label: 'Fitness',   icon: '🏋️', color: 'badge-warning' },
    'lifestyle': { label: 'Lifestyle', icon: '🌿', color: 'badge-secondary' },
    'mindset':   { label: 'Mindset',   icon: '🧘', color: 'badge-info' },
  } %}

  {% set grouped = {} %}
  {% for c in challenges %}
    {% set cat = c.category %}
    {% if grouped[cat] is not defined %}{% set grouped = grouped|merge({(cat): []}) %}{% endif %}
    {% set grouped = grouped|merge({(cat): grouped[cat]|merge([c])}) %}
  {% endfor %}

  {% for cat, items in grouped %}
    {% set meta = categories[cat] ?? { label: cat, icon: '📌', color: 'badge-neutral' } %}
    <div class="mb-6">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-xl">{{ meta.icon }}</span>
        <span class="badge {{ meta.color }} badge-sm font-semibold">{{ meta.label }}</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {% for challenge in items %}
          {% set isActive = challenge.id.toRfc4122 in activeIds %}
          <div class="card bg-base-100 shadow border border-base-300 {{ isActive ? 'opacity-70' : 'hover:shadow-md hover:-translate-y-0.5 transition-all' }}">
            <div class="card-body p-5">
              <div class="flex items-center gap-3 mb-2">
                <span class="text-4xl">{{ challenge.emoji }}</span>
                <div>
                  <h3 class="font-bold leading-tight">{{ challenge.title }}</h3>
                  <span class="badge badge-ghost badge-xs mt-0.5">{{ challenge.durationDays }} jours</span>
                </div>
              </div>
              <p class="text-sm text-base-content/60 mb-4">{{ challenge.description }}</p>
              {% if isActive %}
                <div class="btn btn-sm btn-disabled w-full">✓ En cours</div>
              {% else %}
                <form method="post" action="{{ path('app_challenge_join', {id: challenge.id}) }}">
                  <button type="submit" class="btn btn-sm btn-primary w-full gap-2 font-bold">
                    🚀 Relever le défi
                  </button>
                </form>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endfor %}
</section>

{# ── Historique ───────────────────────────────────────────────────────────── #}
{% if history|length > 0 %}
  <section>
    <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
      <span class="text-2xl">📜</span> Historique
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {% for p in history %}
        <div class="card bg-base-100 shadow-sm border border-base-200 opacity-75">
          <div class="card-body p-4 flex flex-row items-center gap-3">
            <span class="text-2xl">{{ p.challenge.emoji }}</span>
            <div class="flex-1 min-w-0">
              <div class="font-semibold text-sm truncate">{{ p.challenge.title }}</div>
              <div class="text-xs text-base-content/50">
                {{ p.checkIns|length }} / {{ p.challenge.durationDays }} jours ·
                {% if p.status == 'completed' %}
                  <span class="text-success font-semibold">Complété ✓</span>
                {% else %}
                  <span class="text-error">Abandonné</span>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </section>
{% endif %}

{% endblock %}
