{% extends 'base.html.twig' %}

{% block title %}Statistiques & Records — CoachPro{% endblock %}

{% block body %}
<div class="px-4 md:px-8 py-8 max-w-6xl mx-auto space-y-10">

  {# ── EN-TÊTE ──────────────────────────────────────────────────────────────────── #}
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
    <div>
      <div class="text-xs tracking-widest uppercase text-accent opacity-70 mb-1">Performances</div>
      <h1 class="font-display text-4xl md:text-5xl">STATISTIQUES & PRs</h1>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    {# ── COLONNE DE GAUCHE : RECORDS (PRs) ──────────────────────────────────── #}
    <div class="lg:col-span-1 space-y-6">
      <h2 class="text-2xl font-display flex items-center gap-3">
        <svg class="h-6 w-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
        Personal Records
      </h2>

      {% if prs is empty %}
        <div class="card bg-base-200 border border-base-300 p-6 text-center">
          <p class="text-base-content/50 text-sm">Aucun record enregistré pour le moment. Fais ta première séance !</p>
        </div>
      {% else %}
        <div class="flex flex-col gap-3">
          {% for pr in prs %}
            <div class="card bg-base-100 shadow-md border border-base-200 hover:border-accent transition-colors">
              <div class="card-body p-4 flex flex-row items-center justify-between">
                <div>
                  <h3 class="font-bold text-base-content">{{ pr.name }}</h3>
                  <p class="text-xs text-base-content/50 uppercase tracking-widest mt-1">Record Max</p>
                </div>
                <div class="text-right">
                  <div class="font-display text-2xl text-accent">{{ pr.max_weight|number_format(1, '.') }}<span class="text-sm opacity-50 ml-1">kg</span></div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {# ── COLONNE DE DROITE : GRAPHIQUES ────────────────────────────────────── #}
    <div class="lg:col-span-2 space-y-6">
      <h2 class="text-2xl font-display flex items-center gap-3">
        <svg class="h-6 w-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"/></svg>
        Volume Total
      </h2>

      <div class="card bg-base-100 shadow-xl border border-base-200 p-6">
        <div class="text-xs uppercase tracking-widest opacity-40 mb-0.5">Évolution dans le temps</div>
        <p class="text-xs opacity-30 mb-4">Volume soulevé (Reps × Poids) par séance</p>
        
        {% if chart.data.datasets[0].data is empty %}
          <div class="h-64 flex items-center justify-center bg-base-200/50 rounded-lg">
             <p class="opacity-40 text-sm">Pas assez de données pour afficher le graphique.</p>
          </div>
        {% else %}
          <div style="height: 300px;">
            {{ render_chart(chart, {'style': 'width:100%;height:100%'}) }}
          </div>
        {% endif %}
      </div>
      
      <div class="alert bg-base-200/50 border border-base-300 mt-6">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-info shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <div>
          <h3 class="font-bold">Comment le volume est calculé ?</h3>
          <div class="text-xs">Le volume total d'une séance est la somme de (Poids × Répétitions) pour chaque série. Augmenter son volume de semaine en semaine est la clé de la surcharge progressive !</div>
        </div>
      </div>
    </div>
    
  </div>

</div>
{% endblock %}
