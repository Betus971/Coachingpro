{#
  Widget "Coach IA" — chargé en ASYNCHRONE pour ne pas bloquer le rendu de la page
  (l'appel Mistral peut prendre plusieurs secondes sur cache froid).

  Usage : {% include '_coach_advice.html.twig' with { context: 'dashboard' } %}
    - context : 'dashboard' | 'weight' | 'sessions'
#}
{% set ctx = context|default('dashboard') %}

<div class="card bg-gradient-to-br from-primary/10 to-transparent backdrop-blur-sm border-l-4 border-primary shadow-lg mb-6"
     data-advice-url="{{ path('app_coach_advice', {context: ctx}) }}">
  <div class="card-body p-5">
    <div class="flex items-center gap-2 mb-3">
      <span class="text-lg"><i class="bi bi-robot"></i></span>
      <div><div class="section-tag">Coach IA</div></div>
      <span class="ml-auto text-xs text-muted">Mis à jour aujourd'hui</span>
    </div>
    <div class="text-sm leading-relaxed space-y-1.5 text-muted-strong" data-advice-body>
      <p class="opacity-40 flex items-center gap-2">
        <span class="loading loading-dots loading-sm"></span> Le coach analyse tes données…
      </p>
    </div>
  </div>
</div>

<script>
(function () {
  var card = document.currentScript.previousElementSibling;
  if (!card) return;
  var url  = card.getAttribute('data-advice-url');
  var body = card.querySelector('[data-advice-body]');
  fetch(url, { headers: { 'X-Requested-With': 'fetch' } })
    .then(function (r) { return r.ok ? r.text() : ''; })
    .then(function (html) {
      if (!html || html.trim() === '') { card.remove(); return; }
      body.innerHTML = html;
    })
    .catch(function () { card.remove(); });
})();
</script>
