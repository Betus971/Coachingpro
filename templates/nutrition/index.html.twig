{% extends 'base.html.twig' %}
{% block title %}Nutrition — CoachPro{% endblock %}

{% block body %}
<div class="px-6 md:px-8 py-8">

  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
    <div>
      <div class="section-tag green mb-3">Nutrition</div>
      <h1 class="font-display text-4xl md:text-5xl">SUIVI MACROS</h1>
      <p class="text-sm text-muted mt-2">Objectif : 2 700 kcal · 190g Prot · 270g Gluc · 75g Lip</p>
    </div>
    <button onclick="document.getElementById('modal-nutrition').showModal()"
            class="btn btn-secondary font-display tracking-widest">
      + LOG AUJOURD'HUI
    </button>
  </div>

  {# Today card #}
  {% if today %}
    {% set targets = {proteins: 190, carbs: 270, fats: 75, kcal: 2700} %}
    <div class="card-coach p-6 mb-8">
      <div class="flex items-center justify-between mb-4">
        <div class="font-display text-xl text-secondary">AUJOURD'HUI</div>
        <div class="font-display text-3xl">{{ today.kcal }} <span class="text-muted text-lg">/ {{ targets.kcal }} kcal</span></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {% set macros = [
          {label: 'Protéines', val: today.proteinsG, target: targets.proteins, color: 'bg-secondary'},
          {label: 'Glucides',  val: today.carbsG,    target: targets.carbs,    color: 'bg-accent'},
          {label: 'Lipides',   val: today.fatsG,     target: targets.fats,     color: 'bg-primary'},
        ] %}
        {% for m in macros %}
          <div>
            <div class="flex justify-between text-xs text-muted-strong mb-1">
              <span>{{ m.label }}</span>
              <span>{{ m.val }}g / {{ m.target }}g</span>
            </div>
            <div class="progress-bar-bg h-2.5">
              <div class="{{ m.color }} h-2.5 rounded-full"
                   style="width: {{ min((m.val / m.target * 100)|round, 100) }}%"></div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {# History table #}
  {% if logs is not empty %}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {% for log in logs %}
        <div class="card bg-base-100 shadow-xl border border-base-200 overflow-hidden">
          {% set photoCount = (log.imageFilename ? 1 : 0) + log.photos|length %}
          {% if photoCount > 0 %}
            <div class="grid grid-cols-3 gap-0.5 border-b border-base-200 bg-base-200">
              {% if log.imageFilename %}
                <a href="{{ asset('uploads/nutrition/' ~ log.imageFilename) }}" target="_blank" class="block aspect-square">
                  <img src="{{ asset('uploads/nutrition/' ~ log.imageFilename) }}" alt="Repas" class="w-full h-full object-cover">
                </a>
              {% endif %}
              {% for photo in log.photos %}
                <div class="relative aspect-square group">
                  <a href="{{ asset('uploads/nutrition/' ~ photo.filename) }}" target="_blank" class="block w-full h-full">
                    <img src="{{ asset('uploads/nutrition/' ~ photo.filename) }}" alt="Repas" class="w-full h-full object-cover">
                  </a>
                  <form method="post" action="{{ path('app_nutrition_delete_photo', {id: photo.id}) }}"
                        onsubmit="return confirm('Supprimer cette photo ?');"
                        class="absolute top-1 right-1 opacity-0 group-hover:opacity-100 transition-opacity">
                    <input type="hidden" name="_token" value="{{ csrf_token('delphoto' ~ photo.id) }}">
                    <button class="btn btn-xs btn-circle btn-error" title="Supprimer"><i class="bi bi-x-lg"></i></button>
                  </form>
                </div>
              {% endfor %}
            </div>
          {% endif %}
          
          <div class="card-body p-5">
            <div class="flex justify-between items-start mb-2">
              <h3 class="font-display text-xl text-base-content">{{ log.loggedOn|date('d/m/Y') }}</h3>
              <div class="badge badge-primary font-bold">{{ log.kcal }} kcal</div>
            </div>
            
            <div class="flex flex-wrap gap-2 mb-4">
              <div class="badge badge-secondary badge-outline text-xs"><span class="font-bold mr-1">{{ log.proteinsG }}g</span> Prot</div>
              <div class="badge badge-accent badge-outline text-xs"><span class="font-bold mr-1">{{ log.carbsG }}g</span> Gluc</div>
              <div class="badge badge-neutral badge-outline text-xs"><span class="font-bold mr-1">{{ log.fatsG }}g</span> Lip</div>
            </div>
            
            {% if log.notes %}
              <p class="text-sm text-base-content/70 italic border-l-2 border-primary pl-3">"{{ log.notes }}"</p>
            {% endif %}

            <form method="post" action="{{ path('app_nutrition_add_photos', {id: log.id}) }}"
                  enctype="multipart/form-data" class="mt-3 flex items-center gap-2">
              <input type="hidden" name="_token" value="{{ csrf_token('photos' ~ log.id) }}">
              <input type="file" name="photos[]" accept="image/*" multiple
                     class="file-input file-input-bordered file-input-xs flex-1 bg-base-100">
              <button class="btn btn-xs btn-primary" title="Ajouter des photos"><i class="bi bi-plus-lg"></i> Photos</button>
            </form>

            <form method="post" action="{{ path('app_nutrition_delete', {id: log.id}) }}"
                  onsubmit="return confirm('Supprimer cette entrée ?');" class="mt-3 text-right">
              <input type="hidden" name="_token" value="{{ csrf_token('delete_nutrition' ~ log.id) }}">
              <button class="btn btn-ghost btn-xs text-error"><i class="bi bi-trash"></i> Supprimer</button>
            </form>
          </div>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <div class="card-coach p-12 text-center">
      <div class="font-display text-3xl text-muted-strong mb-2">AUCUN LOG</div>
      <p class="text-sm text-muted">Commence à tracker tes macros pour voir ta progression.</p>
    </div>
  {% endif %}

</div>

{# ── Modal: log macros ─────────────────────────────────────────────────────── #}
<dialog id="modal-nutrition" class="modal">
  <div class="modal-box bg-base-200 border border-neutral max-w-md">
    <h3 class="font-display text-2xl mb-1">LOG MACROS</h3>
    <p class="text-xs text-muted mb-6 tracking-wide">Objectifs: 190g Prot · 270g Gluc · 75g Lip · 2 700 kcal</p>
    <form action="{{ path('app_nutrition_new') }}" method="post" enctype="multipart/form-data" class="flex flex-col gap-4">
      <div class="form-control">
        <label class="label pb-1">
          <span class="label-text text-xs tracking-widest uppercase text-muted">Date</span>
        </label>
        <input type="date" name="logged_on" value="{{ 'now'|date('Y-m-d') }}"
               class="input input-bordered bg-base-300 border-neutral focus:border-primary">
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div class="form-control">
          <label class="label pb-1">
            <span class="label-text text-xs tracking-widest uppercase text-secondary">Protéines (g)</span>
          </label>
          <input type="number" name="proteins_g" min="0" max="500" placeholder="190"
                 class="input input-bordered bg-base-300 border-neutral focus:border-secondary">
        </div>
        <div class="form-control">
          <label class="label pb-1">
            <span class="label-text text-xs tracking-widest uppercase text-accent">Glucides (g)</span>
          </label>
          <input type="number" name="carbs_g" min="0" max="1000" placeholder="270"
                 class="input input-bordered bg-base-300 border-neutral focus:border-accent">
        </div>
        <div class="form-control">
          <label class="label pb-1">
            <span class="label-text text-xs tracking-widest uppercase text-primary">Lipides (g)</span>
          </label>
          <input type="number" name="fats_g" min="0" max="500" placeholder="75"
                 class="input input-bordered bg-base-300 border-neutral focus:border-primary">
        </div>
        <div class="form-control">
          <label class="label pb-1">
            <span class="label-text text-xs tracking-widest uppercase text-muted-strong">Calories (kcal)</span>
          </label>
          <input type="number" name="kcal" min="0" max="8000" placeholder="2700"
                 class="input input-bordered bg-base-300 border-neutral focus:border-primary">
        </div>
        <div class="form-control">
          <label class="label pb-1">
            <span class="label-text text-xs tracking-widest uppercase text-muted">Fibres (g)</span>
          </label>
          <input type="number" name="fiber_g" min="0" max="200" placeholder="optionnel"
                 class="input input-bordered bg-base-300 border-neutral">
        </div>
        <div class="form-control">
          <label class="label pb-1">
            <span class="label-text text-xs tracking-widest uppercase text-muted">Eau (L)</span>
          </label>
          <input type="number" name="water_l" step="0.1" min="0" max="10" placeholder="3.0"
                 class="input input-bordered bg-base-300 border-neutral">
        </div>
      </div>
      <div class="form-control">
        <label class="label pb-1">
          <span class="label-text text-xs tracking-widest uppercase text-muted">Notes</span>
        </label>
        <input type="text" name="notes" placeholder="Repas libre, restriction…"
               class="input input-bordered bg-base-300 border-neutral focus:border-primary">
      </div>
      <div class="form-control">
        <label class="label pb-1">
          <span class="label-text text-xs tracking-widest uppercase text-muted">Photos des repas (plusieurs possibles)</span>
        </label>
        <input type="file" name="photos[]" accept="image/*" multiple
               class="file-input file-input-bordered file-input-primary bg-base-300 border-neutral w-full">
      </div>
      <div class="flex gap-3 mt-2">
        <button type="submit" class="btn btn-secondary flex-1 font-display tracking-widest">ENREGISTRER</button>
        <button type="button" onclick="document.getElementById('modal-nutrition').close()"
                class="btn btn-ghost flex-1">Annuler</button>
      </div>
    </form>
  </div>
  <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>
{% endblock %}
