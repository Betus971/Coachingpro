{#
  Dashboard Client — CoachPro
  Design : Samsung Health / Google Fit dark (thème coachpro)
  Rings SVG pour macros, barres arrondies, cards avec accent latéral.
#}

{# ── Macro Twig : SVG ring (réutilisable dans ce template) ─────────────────── #}
{% macro svgRing(pct, color, track, size, stroke) %}
  {% set r = (size - stroke) / 2 %}
  {% set circ = 2 * 3.14159 * r %}
  {% set offset = circ * (1 - (pct / 100)) %}
  <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 {{ size }} {{ size }}">
    <circle class="progress-ring-track"
      cx="{{ size / 2 }}" cy="{{ size / 2 }}" r="{{ r }}"
      stroke="{{ track }}" stroke-width="{{ stroke }}" />
    <circle class="progress-ring-fill"
      cx="{{ size / 2 }}" cy="{{ size / 2 }}" r="{{ r }}"
      stroke="{{ color }}" stroke-width="{{ stroke }}"
      stroke-dasharray="{{ circ }} {{ circ }}"
      stroke-dashoffset="{{ offset }}"
      style="transform-origin: {{ size / 2 }}px {{ size / 2 }}px;" />
  </svg>
{% endmacro %}

{% import _self as m %}

{% set targets = {proteins: 190, carbs: 270, fats: 75, kcal: 2700} %}

<div class="relative overflow-hidden hero-glow space-y-6 pb-8">

  {# ── HERO HEADER ─────────────────────────────────────────────────────────── #}
  <div class="card-elevated p-6 md:p-8">

    {# En-tête texte #}
    <div class="text-xs tracking-widest uppercase text-primary opacity-70 mb-2">
      Objectif personnel · 1m83
    </div>
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <h1 class="font-display text-4xl md:text-5xl leading-none">
          {{ startKg }} KG <span class="text-primary">→ {{ targetKg }} KG</span>
        </h1>
        <p class="text-sm opacity-50 mt-2">
          Objectif : −{{ (startKg - targetKg)|number_format(1, '.') }} kg · Programme PPL + Cardio
        </p>
      </div>

      {# Ring poids centrale #}
      <div class="flex items-center gap-4">
        <div class="relative flex items-center justify-center">
          {{ m.svgRing(progress, '#9b6dff', '#222235', 120, 10) }}
          <div class="absolute text-center">
            <div class="font-display text-2xl text-primary leading-none">{{ currentKg|number_format(1, '.') }}</div>
            <div class="text-xs opacity-50 mt-0.5">kg</div>
            <div class="text-xs text-primary font-semibold mt-1">{{ progress }}%</div>
          </div>
        </div>
        <div class="flex flex-col gap-3">
          <div>
            <div class="text-xs opacity-40 uppercase tracking-wide">Départ</div>
            <div class="font-semibold text-sm">{{ startKg }} kg</div>
          </div>
          <div>
            <div class="text-xs opacity-40 uppercase tracking-wide">Perdu</div>
            <div class="font-semibold text-sm text-success">{% if kilosPerdus > 0 %}−{% endif %}{{ kilosPerdus|number_format(1, '.') }} kg</div>
          </div>
          <div>
            <div class="text-xs opacity-40 uppercase tracking-wide">Restant</div>
            <div class="font-semibold text-sm text-primary">{{ kilosRestants|number_format(1, '.') }} kg</div>
          </div>
        </div>
      </div>
    </div>

    {# Barre de progression linéaire (complément) #}
    <div class="mt-6 max-w-lg">
      <div class="flex justify-between text-xs opacity-40 mb-2">
        <span>{{ startKg }} kg</span>
        <span class="text-primary opacity-100 font-medium">{{ progress }}% atteint</span>
        <span>{{ targetKg }} kg 🎯</span>
      </div>
      <div class="w-full h-2 bg-base-300 rounded-full overflow-hidden">
        <div class="h-2 rounded-full bg-primary transition-all" style="width: {{ progress }}%"></div>
      </div>
    </div>
  </div>

  {# ── GRILLE PRINCIPALE ────────────────────────────────────────────────────── #}
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

    {# ── SÉANCE DU JOUR ─────────────────────────────────────────────────────── #}
    <div class="card-elevated p-6">
      <div class="text-xs uppercase tracking-widest opacity-40 mb-4">Aujourd'hui</div>
      {% if todayWorkout %}
        <div class="flex items-start gap-4 accent-bar-teal pl-3 rounded-r-xl py-1">
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-1">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="#00c9a7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              <span class="text-xs font-semibold uppercase tracking-wide text-secondary">Séance prévue</span>
            </div>
            <h2 class="font-display text-3xl mb-1">{{ todayWorkout.name }}</h2>
            <p class="text-sm opacity-50">{{ todayWorkout.exerciseTemplates|length }} exercices</p>
          </div>
          <a href="{{ path('app_session_new') }}" class="btn btn-secondary btn-sm shrink-0">
            + Logger
          </a>
        </div>
        <div class="flex flex-wrap gap-2 mt-4">
          {% for et in todayWorkout.exerciseTemplates %}
            <div class="badge badge-outline text-xs opacity-60">
              {{ et.exercise.name }}
              <span class="ml-1 text-primary font-semibold">{{ et.targetSets }}×{{ et.targetRepsMin }}{% if et.targetRepsMax != et.targetRepsMin %}–{{ et.targetRepsMax }}{% endif %}</span>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <div class="flex items-center gap-4">
          <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0" style="background:#3dd68c22">
            <svg class="w-5 h-5" fill="none" stroke="#3dd68c" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
          <div>
            <h2 class="font-display text-2xl text-success">Repos actif</h2>
            <p class="text-sm opacity-50 mt-0.5">Marche · étirements · récupération</p>
          </div>
        </div>
      {% endif %}
    </div>

    {# ── NUTRITION DU JOUR ──────────────────────────────────────────────────── #}
    <div class="card-elevated p-6">
      <div class="flex items-center justify-between mb-4">
        <div class="text-xs uppercase tracking-widest opacity-40">Nutrition du jour</div>
        <a href="{{ path('app_nutrition_index') }}" class="text-xs opacity-40 hover:opacity-80 transition-opacity">Historique →</a>
      </div>

      {% if todayNutrition %}
        {# Barre kcal #}
        {% set kcalPct = min(((todayNutrition.kcal / targets.kcal) * 100)|round, 100) %}
        {% set kcalOver = todayNutrition.kcal > targets.kcal %}
        <div class="mb-5">
          <div class="flex items-center justify-between text-sm mb-2">
            <div class="flex items-center gap-1.5 opacity-60">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"/></svg>
              <span>Calories</span>
            </div>
            <span class="font-semibold {{ kcalOver ? 'text-error' : '' }}">
              {{ todayNutrition.kcal }} <span class="opacity-40 font-normal">/ {{ targets.kcal }} kcal</span>
            </span>
          </div>
          <div class="w-full h-2 rounded-full overflow-hidden" style="background:#4f8ef722">
            <div class="h-2 rounded-full transition-all" style="width:{{ kcalPct }}%; background:{{ kcalOver ? '#ff6b6b' : '#4f8ef7' }}"></div>
          </div>
          <div class="text-xs opacity-30 mt-1.5">{{ kcalPct }}% de l'objectif journalier</div>
        </div>

        {# Rings macros SVG #}
        {% set macros = [
          {key: 'proteinsG',  label: 'Protéines', target: targets.proteins, color: '#4f8ef7', track: '#4f8ef722'},
          {key: 'carbsG',     label: 'Glucides',  target: targets.carbs,    color: '#ffc947', track: '#ffc94722'},
          {key: 'fatsG',      label: 'Lipides',   target: targets.fats,     color: '#ff6b6b', track: '#ff6b6b22'},
        ] %}
        <div class="flex justify-around">
          {% for mac in macros %}
            {% set val = attribute(todayNutrition, mac.key) ?? 0 %}
            {% set pct = min(((val / mac.target) * 100)|round, 100) %}
            <div class="flex flex-col items-center gap-1.5">
              <div class="relative flex items-center justify-center">
                {{ m.svgRing(pct, mac.color, mac.track, 72, 7) }}
                <div class="absolute text-center">
                  <span class="text-xs font-bold" style="color:{{ mac.color }}">{{ pct }}%</sp