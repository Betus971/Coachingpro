{% extends 'base.html.twig' %}
{% block title %}Dashboard — CoachPro{% endblock %}

{% block body %}
<div class="relative overflow-hidden hero-glow">

  {# ── Hero header ──────────────────────────────────────────────────────── #}
  <div class="px-8 pt-10 pb-6 border-b border-neutral">
    <div class="text-xs tracking-widest uppercase text-primary mb-2">Programme actif · 1m83</div>
    <h1 class="font-display text-6xl leading-none">
      121 KG <span class="text-primary">→ 95 KG</span>
    </h1>
    <p class="text-sm text-gray-500 mt-3 max-w-lg">
      Perte de ~26 kg de graisse · Programme PPL + Cardio 4×/semaine · Déficit ~500 kcal/j
    </p>

    {# Stat cards #}
    <div class="flex flex-wrap gap-8 mt-6">
      <div class="stat p-0 bg-transparent">
        <div class="stat-value font-display text-4xl text-primary">
          {{ currentKg|number_format(1, '.') }} kg
        </div>
        <div class="stat-desc text-xs tracking-widest uppercase text-gray-500 mt-1">Poids actuel</div>
      </div>
      <div class="stat p-0 bg-transparent">
        <div class="stat-value font-display text-4xl {{ lost > 0 ? 'text-secondary' : 'text-base-content' }}">
          {% if lost > 0 %}−{% endif %}{{ lost|number_format(1, '.') }} kg
        </div>
        <div class="stat-desc text-xs tracking-widest uppercase text-gray-500 mt-1">Perdu depuis le départ</div>
      </div>
      <div class="stat p-0 bg-transparent">
        <div class="stat-value font-display text-4xl">
          {{ (currentKg - targetKg)|number_format(1, '.') }} kg
        </div>
        <div class="stat-desc text-xs tracking-widest uppercase text-gray-500 mt-1">Restant à perdre</div>
      </div>
    </div>

    {# Progress bar #}
    <div class="mt-6 max-w-lg">
      <div class="flex justify-between text-xs text-gray-500 mb-2">
        <span>{{ startKg }} kg</span>
        <span class="text-primary font-medium">{{ progress }}% atteint</span>
        <span>{{ targetKg }} kg 🎯</span>
      </div>
      <div class="w-full bg-base-300 h-2">
        <div class="bg-primary h-2 transition-all duration-700"
             style="width: {{ min(progress, 100) }}%"></div>
      </div>
    </div>
  </div>

  {# ── Today's workout ───────────────────────────────────────────────────── #}
  <div class="px-8 py-6 border-b border-neutral">
    {% if todayWorkout %}
      <div class="section-tag mb-4">Aujourd'hui</div>
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-display text-3xl">{{ todayWorkout.name }}</h2>
        <a href="{{ path('app_session_new') }}" class="btn btn-primary btn-sm font-display tracking-widest">
          + LOGGER CETTE SÉANCE
        </a>
      </div>
      <div class="flex flex-wrap gap-2">
        {% for et in todayWorkout.exerciseTemplates %}
          <div class="badge badge-outline text-xs">
            {{ et.exercise.name }}
            <span class="ml-1 text-primary font-display">{{ et.targetSets }}×{{ et.targetRepsMin }}{% if et.targetRepsMax != et.targetRepsMin %}–{{ et.targetRepsMax }}{% endif %}</span>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="section-tag green mb-4">Aujourd'hui</div>
      <h2 class="font-display text-3xl text-gray-500">REPOS ACTIF</h2>
      <p class="text-sm text-gray-500 mt-2">Marche 30–45 min · étirements · récupération</p>
    {% endif %}
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-0">

    {# ── Recent weight logs ──────────────────────────────────────────────── #}
    <div class="px-8 py-6 border-b border-r border-neutral">
      <div class="flex items-center justify-between mb-4">
        <div>
          <div class="section-tag mb-2">Poids</div>
          <h3 class="font-display text-2xl">HISTORIQUE</h3>
        </div>
        <a href="{{ path('app_weight_index') }}" class="btn btn-ghost btn-xs text-gray-500">Tout voir →</a>
      </div>

      {% if recentWeights is empty %}
        <p class="text-sm text-gray-500">Aucune pesée enregistrée.</p>
      {% else %}
        {# Chart.js sparkline — plus de |min / |max Twig #}
        <div class="mb-4" style="height:80px;position:relative;">
          <canvas id="weight-sparkline"></canvas>
        </div>

        <div class="flex flex-col gap-2">
          {% for log in recentWeights|reverse|slice(0, 5) %}
            <div class="flex justify-between items-center py-2 border-b border-neutral text-sm">
              <span class="text-gray-400">{{ log.loggedOn|date('d/m/Y') }}</span>
              <span class="font-display text-xl text-base-content">{{ log.weightKg }} kg</span>
            </div>
          {% endfor %}
        </div>

        <script type="module">
          import { Chart, LineController, LineElement, PointElement, LinearScale, CategoryScale, Filler, Tooltip }
            from 'chart.js';
          Chart.register(LineController, LineElement, PointElement, LinearScale, CategoryScale, Filler, Tooltip);

          new Chart(document.getElementById('weight-sparkline'), {
            type: 'line',
            data: {
              labels: [{% for log in recentWeights %}"{{ log.loggedOn|date('d/m') }}"{% if not loop.last %},{% endif %}{% endfor %}],
              datasets: [{
                data: [{% for log in recentWeights %}{{ log.weightKg }}{% if not loop.last %},{% endif %}{% endfor %}],
                borderColor: '#e8521a',
                backgroundColor: 'rgba(232,82,26,0.08)',
                borderWidth: 2,
                pointRadius: 3,
                pointBackgroundColor: '#e8521a',
                fill: true,
                tension: 0.3,
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: { legend: { display: false },
                tooltip: { callbacks: { label: ctx => ctx.parsed.y + ' kg' } }
              },
              scales: {
                x: { ticks: { color:'#888', font:{size:10} }, grid: { color:'#222' } },
                y: { ticks: { color:'#888', font:{size:10} }, grid: { color:'#222' } }
              }
            }
          });
        </script>
      {% endif %}

      {# Quick add form #}
      <form action="{{ path('app_weight_new') }}" method="post" class="flex gap-2 mt-4">
        <input type="number" name="weight_kg" step="0.1" min="50" max="300" placeholder="123.5"
               class="input input-sm input-bordered bg-base-300 border-neutral focus:border-primary w-28" required>
        <input type="date" name="logged_on" value="{{ 'now'|date('Y-m-d') }}"
               class="input input-sm input-bordered bg-base-300 border-neutral focus:border-primary flex-1">
        <button class="btn btn-primary btn-sm">+</button>
      </form>
    </div>

    {# ── Today's nutrition ───────────────────────────────────────────────── #}
    <div class="px-8 py-6 border-b border-neutral">
      <div class="flex items-center justify-between mb-4">
        <div>
          <div class="section-tag green mb-2">Nutrition</div>
          <h3 class="font-display text-2xl">MACROS DU JOUR</h3>
        </div>
        <a href="{{ path('app_nutrition_index') }}" class="btn btn-ghost btn-xs text-gray-500">Historique →</a>
      </div>

      {% set targets = {proteins: 190, carbs: 270, fats: 75, kcal: 2700} %}
      {% if todayNutrition %}
        {# Kcal #}
        <div class="flex justify-between text-sm mb-3">
          <span class="text-gray-400">Calories</span>
          <span class="font-display text-xl">
            {{ todayNutrition.kcal }}
            <span class="text-gray-500 text-sm">/ {{ targets.kcal }} kcal</span>
          </span>
        </div>
        {# Macro bars #}
        {% set macros = [
          {label: 'Protéines', val: todayNutrition.proteinsG, target: targets.proteins, cls: 'macro-bar-prot'},
          {label: 'Glucides',  val: todayNutrition.carbsG,    target: targets.carbs,    cls: 'macro-bar-carb'},
          {label: 'Lipides',   val: todayNutrition.fatsG,     target: targets.fats,     cls: 'macro-bar-fat'},
        ] %}
        {% for m in macros %}
          <div class="mb-3">
            <div class="flex justify-between text-xs text-gray-400 mb-1">
              <span>{{ m.label }}</span>
              <span>{{ m.val }}g / {{ m.target }}g</span>
            </div>
            <div class="w-full bg-base-300 h-1.5">
              <div class="{{ m.cls }} h-1.5"
                   style="width: {{ min((m.val / m.target * 100)|round, 100) }}%"></div>
            </div>
          </div>
        {% endfor %}
        <a href="{{ path('app_nutrition_index') }}" class="btn btn-ghost btn-xs mt-2 text-gray-400">Modifier</a>
      {% else %}
        <p class="text-sm text-gray-500 mb-4">Aucun log nutritionnel pour aujourd'hui.</p>
        <a href="{{ path('app_nutrition_index') }}" class="btn btn-secondary btn-sm">+ Logger les macros</a>
      {% endif %}
    </div>

  </div>

  {# ── Recent sessions ───────────────────────────────────────────────────── #}
  <div class="px-8 py-6">
    <div class="flex items-center justify-between mb-4">
      <div>
        <div class="section-tag mb-2">Séances</div>
        <h3 class="font-display text-2xl">DERNIÈRES SÉANCES</h3>
      </div>
      <a href="{{ path('app_session_new') }}" class="btn btn-primary btn-sm font-display tracking-widest">+ NOUVELLE</a>
    </div>

    {% if recentSessions is empty %}
      <p class="text-sm text-gray-500">Aucune séance enregistrée. C'est l'heure de suer ! 💪</p>
    {% else %}
      <div class="flex flex-col gap-2">
        {% for session in recentSessions %}
          <a href="{{ path('app_session_show', {id: session.id}) }}"
             class="card-dark p-4 flex items-center justify-between hover:bg-base-300 transition-colors">
            <div>
              <div class="font-medium text-sm">{{ session.name }}</div>
              <div class="text-xs text-gray-500 mt-0.5">
                {{ session.performedAt|date('l d/m/Y')|replace({'Monday': 'Lundi', 'Tuesday': 'Mardi', 'Wednesday': 'Mercredi', 'Thursday': 'Jeudi', 'Friday': 'Vendredi', 'Saturday': 'Samedi', 'Sunday': 'Dimanche'}) }}
                {% if session.durationMinutes %} · {{ session.durationMinutes }} min{% endif %}
                {% if session.rpe %} · RPE {{ session.rpe }}/10{% endif %}
              </div>
            </div>
            <div class="text-right">
              <div class="font-display text-primary text-lg">{{ session.sets|length }}</div>
              <div class="text-xs text-gray-500">séries</div>
            </div>
          </a>
        {% endfor %}
      </div>
    {% endif %}
  </div>

</div>
{% endblock %}
