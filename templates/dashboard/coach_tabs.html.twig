{% extends 'base.html.twig' %}
{% block title %}Dashboard Coach — CoachPro{% endblock %}

{% block body %}

  {# ── EN-TÊTE COACH ────────────────────────────────────────────────────────── #}
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 mb-6">
    <div>
      <h1 class="text-2xl font-bold">Tableau de bord Coach</h1>
      <p class="text-base-content/50 text-sm">Gérez vos clients et suivez votre programme</p>
    </div>
    <a href="{{ path('app_coach_client_invite') }}" class="btn btn-primary btn-sm gap-1">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Nouveau Client
    </a>
  </div>

  {# ── TABS ─────────────────────────────────────────────────────────────────── #}
  <div role="tablist" class="tabs tabs-bordered mb-6">

    <input type="radio" name="coach_tabs" role="tab" class="tab" aria-label="Mon Programme" checked="checked"/>
    <div role="tabpanel" class="tab-content pt-6">
      {{ include('dashboard/_client_content.html.twig') }}
    </div>

    <input type="radio" name="coach_tabs" role="tab" class="tab" aria-label="Mes Clients"/>
    <div role="tabpanel" class="tab-content pt-6">
      <div class="card bg-base-100 shadow-sm border border-base-200">
        <div class="card-body">
          <h2 class="card-title text-base">
            <svg class="h-4 w-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            Mes Clients
          </h2>
          {% if clients is empty %}
            <div class="text-center py-8 text-base-content/40">
              <p class="text-sm">Vous n'avez pas encore de clients assignés.</p>
            </div>
          {% else %}
            <div class="overflow-x-auto">
              <table class="table table-sm">
                <thead>
                  <tr class="text-base-content/50 text-xs uppercase">
                    <th>Nom</th><th>Email</th><th>Inscrit le</th><th></th>
                  </tr>
                </thead>
                <tbody>
                  {% for client in clients %}
                    <tr class="hover">
                      <td class="font-bold text-sm">{{ client.firstName }} {{ client.lastName }}</td>
                      <td class="text-sm text-base-content/60">{{ client.email }}</td>
                      <td class="text-sm text-base-content/60">{{ client.createdAt|date('d/m/Y') }}</td>
                      <td><a href="{{ path('app_coach_client_show', {id: client.id}) }}" class="btn btn-ghost btn-xs">Voir dossier</a></td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          {% endif %}
        </div>
      </div>
    </div>

  </div>

{% endblock %}
