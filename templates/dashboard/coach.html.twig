{% extends 'base.html.twig' %}
{% block title %}Dashboard Coach — CoachPro{% endblock %}

{% block body %}
<div class="p-6">
  <h1 class="text-3xl font-bold mb-6 text-primary">Tableau de bord (Coach)</h1>
  
  <div class="card bg-base-200 shadow-xl">
    <div class="card-body">
      <h2 class="card-title mb-4">Mes Clients</h2>
      
      {% if clients is empty %}
        <p class="text-muted">Vous n'avez pas encore de clients assignés.</p>
      {% else %}
        <div class="overflow-x-auto">
          <table class="table">
            <thead>
              <tr>
                <th>Nom</th>
                <th>Email</th>
                <th>Inscrit le</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              {% for client in clients %}
                <tr>
                  <td>{{ client.firstName }} {{ client.lastName }}</td>
                  <td>{{ client.email }}</td>
                  <td>{{ client.createdAt|date('d/m/Y') }}</td>
                  <td>
                    <button class="btn btn-sm btn-outline">Voir</button>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
