{% extends 'base.html.twig' %}
{% block title %}Mon Profil — CoachPro{% endblock %}

{% block body %}
<div class="max-w-xl mx-auto">
    <div class="mb-6">
        <h1 class="text-3xl font-display text-primary">Mon Profil</h1>
        <p class="text-muted text-sm mt-1">Gérez vos informations personnelles.</p>
    </div>

    <div class="card bg-base-200 shadow-xl border border-base-300">
        <div class="card-body">
            {{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}
            
                <div class="form-control w-full mb-4">
                    {{ form_label(form.email, null, {'label_attr': {'class': 'label font-medium'}}) }}
                    {{ form_widget(form.email) }}
                    {{ form_errors(form.email) }}
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="form-control w-full">
                        {{ form_label(form.firstName, null, {'label_attr': {'class': 'label font-medium'}}) }}
                        {{ form_widget(form.firstName) }}
                        {{ form_errors(form.firstName) }}
                    </div>
                    
                    <div class="form-control w-full">
                        {{ form_label(form.lastName, null, {'label_attr': {'class': 'label font-medium'}}) }}
                        {{ form_widget(form.lastName) }}
                        {{ form_errors(form.lastName) }}
                    </div>
                </div>

                <div class="form-control w-full mt-4">
                    {{ form_label(form.heightCm, null, {'label_attr': {'class': 'label font-medium'}}) }}
                    {{ form_widget(form.heightCm) }}
                    {{ form_errors(form.heightCm) }}
                </div>

                <div class="divider">Sécurité</div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="form-control w-full">
                        {{ form_label(form.plainPassword.first, null, {'label_attr': {'class': 'label font-medium text-warning'}}) }}
                        {{ form_widget(form.plainPassword.first) }}
                        {{ form_errors(form.plainPassword.first) }}
                    </div>
                    <div class="form-control w-full">
                        {{ form_label(form.plainPassword.second, null, {'label_attr': {'class': 'label font-medium text-warning'}}) }}
                        {{ form_widget(form.plainPassword.second) }}
                        {{ form_errors(form.plainPassword.second) }}
                    </div>
                </div>

                <div class="card-actions justify-end mt-6">
                    <button type="submit" class="btn btn-primary">Enregistrer les modifications</button>
                </div>
                
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
